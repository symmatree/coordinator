# Logging, notify (display/LED/buzzer), telemetry streams, board misc
#
# --- Logging ---
# Full EKF replay suite: log while disarmed (2), record replay data (1), rotate on
#   disarm.  provenance: 871c15b 2026-07-11
LOG_DISARMED,2
LOG_REPLAY,1
LOG_FILE_DSRMROT,1
# Raw IMU logging enabled: ArduPilot's recommended bitmask (65535) + bit 19 /
#   IMU_RAW (524288) = 589823. Bit 19 is the gate for the raw-gyro logging that
#   replaced the IMU batch sampler on 4.5+ H7 boards; it feeds the Filter Review
#   tool and any FFT of the FC's own gyro. Produces large logs -- note LOG_DISARMED=2
#   above, so a long bench session writes a lot.
#   provenance: 2026-09-05
LOG_BITMASK,589823
# Raw-IMU logging options, paired with LOG_BITMASK bit 19 -- neither does anything
#   without the other. 9 = bit 0 (primary gyro only) + bit 3 (log pre- AND post-filter),
#   ArduPilot's recommended value to keep the logging rate survivable.
#   provenance: 2026-09-05
INS_RAW_LOG_OPT,9
#
# --- Notify ---
# SH1106 OLED (NTF_DISPLAY_TYPE=2), LED types bitmask, buzzer on GPIO 32.
#   provenance: 91e7055 (display), ca8cd23 2026-07-31 (LED types fix after upgrade)
NTF_DISPLAY_TYPE,2
NTF_LED_TYPES,33025
NTF_BUZZ_PIN,32
#
# --- Scripting ---
# Lua scripting enabled (used for quicktune).  provenance: 8d0f52a
SCR_ENABLE,1
#
# --- Telemetry streams on MAV1 (primary GCS channel) ---
#   provenance: 6ec21a2 (SR2), migrated to MAV1_* names in the 4.7 upgrade (ea7afee)
MAV1_EXT_STAT,1
MAV1_POSITION,1
MAV1_RAW_SENS,1
MAV1_RC_CHAN,1
MAV1_EXTRA1,1
MAV1_EXTRA2,1
MAV1_EXTRA3,1
#
# --- Telemetry streams on MAV2 (SERIAL4, the coordinator) ---
# MAVLink channels are assigned in SERIALn order over the MAVLink ports, so with SERIAL0
# (USB), SERIAL4 (coordinator), SERIAL6 (ELRS) and SERIAL9 (OTG) all on protocol 2, the
# coordinator is MAV2. Everything except RC_CHAN and RAW_SENS was already at 2 Hz; only
# RC_CHAN is pinned here, the rest stay as the FC has them.
#
# RC_CHAN turns on SERVO_OUTPUT_RAW and RC_CHANNELS to the coordinator, which the
# coordinator tlog records (#220). Two uses:
#   * SERVO_OUTPUT_RAW is motor commands on the COORDINATOR's clock -- an independent
#     cross-check on the capture<->FC time join rather than another consumer of it.
#   * RC_CHANNELS lets a spare switch on the radio annotate a flight from the air
#     (mark arriving on station, mark a target, mark something felt wrong) instead of
#     annotating a file afterwards.
# 2 Hz to match the rest of the MAV2 row; the added traffic is ~4 msg/s on a 1.5 Mbaud
# link that currently carries ~41. NOT set on MAV3 -- that is the ELRS link and it is
# already saturated (#197).
MAV2_RC_CHAN,2
#
# --- Unused serial ports ---
# SERIAL7 disabled (the abandoned F9P-move port); SERIAL9 (OTG) unused.
SERIAL7_PROTOCOL,-1
SERIAL7_BAUD,115
SERIAL9_PROTOCOL,2
SERIAL9_BAUD,460
#
# --- Board relays / misc ---
# RELAY2/3 = the board's other switched pads, GPIO 81 "VSW" and GPIO 82 "CAMSW";
#   enabled as relays but unused by this build.
RELAY2_FUNCTION,1
RELAY3_FUNCTION,1
# RTC timezone offset +240 min (EDT).
BRD_RTC_TZ_MIN,240
# Safety off at boot. #183's boot-in-safe (DEFLT=1) left the drone un-armable -- the safety
# button doesn't disengage -- so reverted to flyable until the switch is confirmed working.
#   provenance: 2026-08-09
BRD_SAFETY_DEFLT,0
# Safety-switch output mask: which outputs may move while safety is engaged. 16368 =
#   outputs 5-14; motors (outputs 1-4) stay held until the safety switch is released.
BRD_SAFETY_MASK,16368
