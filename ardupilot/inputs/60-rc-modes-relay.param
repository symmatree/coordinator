# 60 -- RC aux, flight modes, arming, VTX relay + radio/VTX serial links
#
# FC parameters only; the EdgeTX mix/switch table is in ground-station.md + model01.yml.
#
# --- Radio + VTX serial links ---
# SERIAL6 = Matek ELRS R24-TD, proto 2 = MAVLink2 (control + telem + RTCM uplink); 460800
#   to match the ELRS link.
SERIAL6_PROTOCOL,2
SERIAL6_BAUD,460
# SERIAL3 = Walksnail VTX MSP DisplayPort (TX3/RX3, data only; VTX power is on RELAY4 below).
SERIAL3_PROTOCOL,42
SERIAL3_BAUD,115
#
# --- Flight modes (CH6 / SB) ---
# Loiter (5) and AltHold (2).
FLTMODE_CH,6
FLTMODE1,5
FLTMODE4,2
#
# --- Aux switches ---
# CH5 = arm/disarm on the L3 latch.
RC5_OPTION,153
# CH7/SD = LAND, deliberately not RTL (climb-then-home is dangerous under canopy).
RC7_OPTION,18
# CH8 = lost-vehicle buzzer while SF held; CH9 = VTX relay (below).
RC8_OPTION,30
RC9_OPTION,36
#
# --- Arming ---
# Rudder arm/disarm off -- arming is on the CH5 latch, so a rudder gesture must not arm.
#   provenance: dc198ce 2026-06-17
ARMING_RUDDER,0
#
# --- VTX relay (Lucid HD VTX 9/12V BEC on GPIO 83, controlled by CH9) ---
RELAY4_FUNCTION,1
# RELAY4_DEFAULT=0 = VTX cold at boot (bench-friendly). The old ELRS-cold-boot failure
#   was fixed 2026-07-27 by moving the RX to the 4V5 rail; a =0 boot now links cleanly.
#   See flight-platform.md.  provenance: d41a75d 2026-07-26
RELAY4_DEFAULT,0
# RELAY2/3 are the board's other switched pads -- GPIO 81 "VSW" (switched V rail) and
#   GPIO 82 "CAMSW" (camera switch). Enabled as relays but unused by this build.
RELAY2_FUNCTION,1
RELAY3_FUNCTION,1
