# 70 -- Battery monitoring and power
#
# 6S Li-ion pack. Most thresholds came from Mission Planner "Initial Tune" (6S
# Li-ion selected). See ardupilot.md "Battery monitoring" and flight-platform.md.
#
# Monitor via ESC telemetry (9), NOT the FC analog input -- the FC current sense is
#   dead (arc-blown, #117). Volts/current arrive on SERIAL8 (see 20-serial) from a
#   custom-calibrated AM32 build: voltage ~1%, current scale generic so mAh is
#   +/-15%.  provenance: 954150979 2026-07-27; [flight-platform.md; #117]
BATT_MONITOR,9
BATT_ESC_MASK,0
BATT_CAPACITY,8000
#
# Voltage thresholds (~3.20 / 3.10 / 3.00 V per cell on 6S). BATT_CRT_VOLT=18 is
#   toward the low end for sustained load -- raise slightly if it Lands early under
#   sag.  [ardupilot.md]
BATT_ARM_VOLT,19.2
BATT_LOW_VOLT,18.6
BATT_CRT_VOLT,18
BATT_LOW_MAH,0
BATT_CRT_MAH,250
BATT_LOW_TIMER,0
#
# Failsafe ACTIONS. NOTE/DISCREPANCY: ardupilot.md prose describes LOW as warn-only
#   (BATT_FS_LOW_ACT=0), but the export has 1 = Land on BOTH low and critical. Land
#   is the safe action under canopy (RTL is not), so Land-on-low may be intentional
#   and the doc stale -- but confirm which you want. Recorded as the export value.
#   [ardupilot.md "Failsafe actions"]
BATT_FS_LOW_ACT,1
BATT_FS_CRT_ACT,1
#
# Sag compensation: scale thrust between these pack voltages. No current limit
#   (MOT_BAT_CURR_MAX=0) despite the ~80 A pack.  provenance: ac57658 2026-04-25
MOT_BAT_VOLT_MAX,24.6
MOT_BAT_VOLT_MIN,16.8
