# Failsafe and fence
#
# Radio and GCS failsafe; landing; geofence. Operating envelope: canopy-ops.md.
#
# --- Failsafe ---
# Radio failsafe: 1 = always RTL. Over the woods a landing is a loss; RTL for any failsafe
#   that offers it.  provenance: 2026-11-07
FS_THR_ENABLE,1
# GCS failsafe: 1 = RTL.
FS_GCS_ENABLE,1
# EKF failsafe: 2 = switch to AltHold when the mode needs position. Its options are report,
#   Land, or AltHold; RTL needs the position estimate this failsafe has stopped trusting, so
#   AltHold, which holds altitude under the pilot, rather than Land.  provenance: 2026-11-07
FS_EKF_ACTION,2
#
# --- RTL ---
# Climb to at least 40 m above home before returning, clear of the canopy.
#   provenance: 2026-11-07
RTL_ALT_M,40
#
# --- Land ---
# LAND final descent (below LAND_ALT_LOW_M) to touchdown, in m/s. Lowered from 0.5
#   after the 2026-10-30 blackfly-flight landing tipped over.
LAND_SPD_MS,0.4
#
# --- Fence ---
# Fence is off; the limits below are staged, not active.
FENCE_ENABLE,0
FENCE_ACTION,3
FENCE_ALT_MAX,120
FENCE_RADIUS,150
