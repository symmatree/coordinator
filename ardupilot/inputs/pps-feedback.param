# PPS into the FC, logged as a camera feedback edge. Why, and the pad survey: #11.
#
# Pad S11 = PE5 = GPIO(60). TBS silkscreens servo pads "S" where ArduPilot says "M".
SERVO11_FUNCTION,-1
CAM1_FEEDBAK_PIN,60
#
# 0 = TriggerLow = INTERRUPT_FALLING. The default is 1, and on a DS3234 the rising edge
# is the half second and the undriven one.
CAM1_FEEDBAK_POL,0
#
# 5 = MAVLINK. No camera is fitted; a non-zero type is what installs the feedback ISR,
# and this one binds no pin, relay or servo output.
CAM1_TYPE,5
