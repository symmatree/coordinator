# PPS into the FC, logged as a camera feedback edge.
#   what each value means      docs/rekon10/ardupilot.md, "Camera feedback pin"
#   the pad, and what is free  docs/rekon10/flight-platform.md, "Flight controller"
#   what the signal is for     docs/time-base.md
#
# Pad S12 = PE6 = GPIO(61): where the leg is soldered (seen 2026-11-07). The config had
#   said S11 (PE5, GPIO 60), so the handler watched an empty pad and no CAM row was ever
#   logged. EXTI line 6 is free here: PA6, PB6, PC6, PD6 are SPI1/I2C1/USART6/USART2
#   peripherals and the hwdef declares no interrupt pins.  provenance: 2026-11-07
SERVO12_FUNCTION,-1
CAM1_FEEDBAK_PIN,61
# S11 back to its default (disabled): nothing is on it.
SERVO11_FUNCTION,0
#
# 0 = INTERRUPT_FALLING. The default is 1, the rising edge, which is the wrong one here.
CAM1_FEEDBAK_POL,0
#
# 5 = MAVLINK. No camera is fitted; a non-zero type is what owns the feedback pin. The
# ISR itself is installed by the first take_picture(), which scripts/pps-feedback-arm.lua
# issues once per boot.
CAM1_TYPE,5
