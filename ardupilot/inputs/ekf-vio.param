# VIO / ExtNav and EKF3 source sets
#
# VIO is OFF: no source set selects ExtNav and the VISO backend is disabled, so the
# FC neither waits for nor fuses VISION_POSITION_ESTIMATE. All three source sets are
# the GPS lane. Mechanism and the fusion details, for when it comes back:
# docs/ardupilot-extnav-fusion.md, docs/ardupilot-vio.md.
#
# --- Companion link (SERIAL4 -> coordinator Pi 4B) ---
# Proto 2 = MAVLink2 (required for ExtNav ingest). 1.5 Mbaud is the working VIO rate.
#   provenance: 04b2592, bcd7c65 2026-07-08
SERIAL4_PROTOCOL,2
SERIAL4_BAUD,1500
#
# Onboard telemetry to the coordinator on this link (MAV2 = SERIAL4). Flight-state, an
# onboard tlog, and VIO yaw-align diagnosis. 2 Hz -- enough for monitoring, modest to
# keep onboard logging writes light. EXT_STAT=SYS_STATUS+GPS_RAW (health/sats),
# POSITION=global/local pos, EXTRA1=ATTITUDE (yaw vs AHRS), EXTRA2=VFR_HUD (heading/GS),
# EXTRA3=AHRS+EKF_STATUS_REPORT+VIBRATION.  provenance: 2026-08-03
MAV2_EXT_STAT,2
MAV2_POSITION,2
MAV2_EXTRA1,2
MAV2_EXTRA2,2
MAV2_EXTRA3,2
#
# --- EKF3 source sets ---
# SRC1 = GPS -- the flown lane (POSXY/VELXY/VELZ=GPS, POSZ=Baro, YAW=compass).
EK3_SRC1_POSXY,3
EK3_SRC1_VELXY,3
EK3_SRC1_POSZ,1
EK3_SRC1_VELZ,3
EK3_SRC1_YAW,1
# SRC2 was VIO/ExtNav (POSXY=6). Set to the GPS lane: VIO is removed for now and a
#   source set pointing at ExtNav with nothing publishing is worse than not having one
#   (coordinator#313). Set explicitly rather than deleted -- a fragment is applied, not
#   a reset, so a deleted line leaves the flown value on the FC.
#   provenance: coordinator#313 2026-09-17
EK3_SRC2_POSXY,3
EK3_SRC2_VELXY,3
EK3_SRC2_VELZ,3
EK3_SRC2_YAW,1
# SRC3 = the GPS lane. With SRC2 also GPS now, all three positions are identical and
#   the CH10 switch below is inert; it stays assigned so the wiring and the switch
#   position survive for when VIO returns.
EK3_SRC3_POSXY,3
EK3_SRC3_VELXY,3
EK3_SRC3_VELZ,3
EK3_SRC3_YAW,1
# Runtime source-set select on SC/CH10.
RC10_OPTION,90
# SRC_PER_CORE (bit 3 = 8) ran core 1 on SRC2/VIO so the VIO lane was computed and
#   logged beside the GPS lane. Off: there is no VIO lane to compute, and dedicating a
#   core to a second GPS lane buys nothing.  provenance: coordinator#313 2026-09-17
EK3_SRC_OPTIONS,0
# Reject GPS vertical velocity when reported vertical accuracy > 0.15 m.
EK3_GPS_VACC_MAX,0.15
# Baro altitude noise, widened to absorb the measured hover propwash offset (~1.2 m).
EK3_ALT_M_NSE,2
#
# --- VISION_POSITION_ESTIMATE ingest (VISO) ---
# Disabled. Was 2 (IntelT265 backend, which yaw-aligns the VIO frame onto AHRS since
#   stereo VINS has no heading reference). Nothing publishes VISION_POSITION_ESTIMATE
#   any more, so the backend is off rather than left waiting.
#   provenance: coordinator#313 2026-09-17
VISO_TYPE,0
#
# The VISO values below are inert while VISO_TYPE=0. They are kept because they are
# measurements, not tuning guesses: the lever arm came off the OAK-D mount and the
# delay was measured on the link. Re-deriving them would cost a bench session.
# Measured VINS->FC transport latency ~100 ms (not the 10 ms default).
VISO_DELAY_MS,100
# OAK-D -> FC lever arm, metres FRD. Y carries a half-baseline offset (VINS reports in
#   the cam0/left-imager frame). Coupled to the camera extrinsics (oak_d.yaml).
VISO_POS_X,0.072
VISO_POS_Y,-0.0375
VISO_POS_Z,-0.116
# Fusion noise. Position covariance is floored by POS_M_NSE; VIO velocity ignores the
#   message covariance and fuses at VEL_M_NSE (so a router vel covariance only takes
#   effect if mirrored here).
VISO_POS_M_NSE,0.2
VISO_VEL_M_NSE,0.1
VISO_YAW_M_NSE,0.2
