# 30 -- Compass and GPS (Holybro F9P Rover Lite)
#
# Configuration/geometry only. Per-vehicle magnetometer calibration (offsets,
# scale, diagonals, device IDs, declination) is NOT here -- it is produced by the
# on-vehicle compass cal and lives only in the ground-truth export; see
# 95-calibration-identity.param for the snapshot.
#
# --- GPS ---
# F9P on the mast, sole GNSS. Type 2 = uBlox. Wired to SERIAL2 (see 20-serial).
GPS1_TYPE,2
# Auto-config the uBlox (3 = configure + save cfg).  provenance: a4934db 2026-05-16
GPS_AUTO_CONFIG,3
# Antenna lever arm from the FC origin, metres FRD. Z-down sign verified (#170).
#   [ardupilot.md compass/GPS]  provenance: ca8cd23 2026-07-31
GPS1_POS_X,-0.082
GPS1_POS_Z,-0.125
#
# RTK: corrections arrive base -> NTRIP -> mavproxy -> ELRS uplink -> F9P. The
# recurring "no RTK" symptom is a network/anchor problem, not an FC param.
#   [docs/rtk-corrections-path.md]. GPS_AUTO_SWITCH / GPS_BLEND_MASK / GPS_INJECT_TO
#   sit at defaults and are intentionally omitted.
#
# --- Compass ---
# Single external compass on the F9P I2C bus; 2nd/3rd instances disabled.
COMPASS_EXTERNAL,1
COMPASS_EXTERN2,1
COMPASS_USE2,0
COMPASS_USE3,0
# CAVEAT: COMPASS_ORIENT=6 (Yaw270) is documented as HISTORICAL M100-era in
#   ardupilot.md -- likely a stale placeholder, not a verified orientation for the
#   F9P mast mount. Re-confirm from an outdoor cal before trusting it. Recorded
#   here as the current committed value, not endorsed.  [ardupilot.md "Compass and GPS"]
COMPASS_ORIENT,6
COMPASS_ORIENT2,6
#
# --- Arming ---
# Rudder arm/disarm disabled -- arming is on the CH5 latch (see 60-rc-modes-relay),
# so a rudder gesture must not arm.  provenance: dc198ce 2026-06-17
ARMING_RUDDER,0
