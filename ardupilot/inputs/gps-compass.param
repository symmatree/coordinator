# GPS + compass (Holybro F9P Rover Lite)
#
# One device on the mast that ArduPilot sees as several things: the ZED-F9P GNSS
# receiver, an onboard I2C compass, and the connector's safety button + LED. All of
# its config is grouped here. Wiring: flight-platform.md. Per-vehicle compass
# calibration (offsets/scale/device IDs) is produced by the compass cal and lives
# only in the ground-truth export, not here.
#
# --- Serial link (SERIAL2, the old M100 port) ---
# Proto 5 = GPS. RTK/RTCM corrections are forwarded to the F9P on this UART.
#   provenance: 4f82b3d 2026-06-21
SERIAL2_PROTOCOL,5
SERIAL2_BAUD,115
#
# --- GNSS ---
GPS1_TYPE,2
# uBlox auto-config 3 = clear the F9P's saved config on boot, then auto-configure
#   serial-only each boot (AP_GPS: GPS_AUTO_CLEAR_CONFIG_UBLOX_SERIAL_ONLY).
#   provenance: a4934db 2026-05-16
GPS_AUTO_CONFIG,3
# Antenna lever arm from the FC origin, metres FRD (Z down).  provenance: ca8cd23 2026-07-31
GPS1_POS_X,-0.082
GPS1_POS_Z,-0.125
# Log RXM-RAWX (raw carrier phase + pseudorange) to dataflash as GRXH/GRXS. GRXS carries
#   per-satellite cno and lock -- carrier-phase lock time, whose reset to zero IS a cycle
#   slip. That is the only instrument we have for why RTK reaches Float and rarely Fixed
#   (#195): GPS_RTK is never generated for a u-blox rover, so correction age, baseline and
#   ambiguity state are absent from both dataflash and MAVLink (docs/flight-data-interpretation.md).
#   The value is a sample count, not a rate -- it lands in a UBX CFG-MSG rate field, a divisor
#   of nav solutions. At GPS1_RATE_MS=200, 5 gives 1 Hz. Measured SERIAL2 (UART instance 2, which
#   runs at 230400 = 23040 B/s, not SERIAL2_BAUD) is Rx median ~8 KB/s, p95 11.8-14.1; 1 Hz RAWX
#   adds ~1.9 KB/s, 5 Hz would add ~9.5 and reach the ceiling.
#   provenance: db6f872 2026-09-10
GPS_RAW_DATA,5
#
# --- Compass (onboard the F9P, on its I2C) ---
# Single external compass; 2nd/3rd instances disabled.
COMPASS_EXTERNAL,1
COMPASS_EXTERN2,1
COMPASS_USE2,0
COMPASS_USE3,0
# Orientation of the F9P mag as mounted (Yaw270).
COMPASS_ORIENT,6
COMPASS_ORIENT2,6
