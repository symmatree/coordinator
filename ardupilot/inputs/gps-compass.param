# GPS + compass (Holybro F9P Rover Lite)
#
# One device on the mast that ArduPilot sees as several things: the ZED-F9P GNSS
# receiver, an onboard I2C compass, and the connector's safety button + LED. All of
# its config is grouped here. Wiring: flight-platform.md. The compass calibration's
# numbers are pinned below; its device IDs live only in the ground-truth export.
#
# --- Serial link (SERIAL2, the old M100 port) ---
# Proto 5 = GPS. RTK/RTCM corrections are forwarded to the F9P on this UART.
#   provenance: 4f82b3d 2026-06-21
SERIAL2_PROTOCOL,5
SERIAL2_BAUD,115
#
# --- GNSS ---
GPS1_TYPE,2
# uBlox auto-config 3 = clear the F9P's saved config on boot, then auto-configure
#   serial-only each boot (AP_GPS: GPS_AUTO_CLEAR_CONFIG_UBLOX_SERIAL_ONLY).
#   provenance: a4934db 2026-05-16
GPS_AUTO_CONFIG,3
# Antenna lever arm from the FC origin, metres FRD (Z down).  provenance: ca8cd23 2026-07-31
GPS1_POS_X,-0.082
GPS1_POS_Z,-0.125
# Raw GNSS observation logging. Non-zero makes the driver request UBX RXM-RAWX and log it
#   as GRXH (per epoch: rcvTime, week, leapS, numMeas, recStat) and GRXS (per satellite:
#   prMes, cpMes, doMes, gnss, sv, freq, lock, cno, prD, cpD, doD, trk).
#   Why: the only GPS state in the dataflash today is GPS (fix status, NSats, HDop, accuracy),
#   GPA (accuracy + RTCM fragment counts) and UBX1/UBX2 (RF noise/AGC). None of it is
#   per-satellite and none of it is carrier phase, so there is nothing to look at when a
#   question about receiver behaviour comes up. A null result is still worth having.
#   Why 5: the value is a sample count, not a rate -- it is passed unmodified into the UBX
#   CFG-MSG rate field, which counts navigation solutions. At GPS1_RATE_MS=200 this gives 1 Hz;
#   1 would give 5 Hz and five times the UART and dataflash volume for no added resolution.
#   Requires a reboot.
#   provenance: db6f872 2026-09-10
GPS_RAW_DATA,5
#
# --- Compass (onboard the F9P, on its I2C) ---
# Single external compass; 2nd/3rd instances disabled.
COMPASS_EXTERNAL,1
COMPASS_EXTERN2,1
COMPASS_USE2,0
COMPASS_USE3,0
# Orientation of the F9P mag as mounted (Yaw270).
#
# ORIENT is also a calibration output, conditionally: _accept_calibration() saves it
# only when the report asks for an orientation check, the compass is external, and
# COMPASS_AUTO_ROT >= 2 (it is 2 here). Both conditions hold on this airframe, so a cal
# can move these.
COMPASS_ORIENT,6
COMPASS_ORIENT2,6
#
# --- Compass calibration (the measured numbers) ---
#
# What a successful cal actually writes, read off AP_Compass_Calibration.cpp
# _accept_calibration(): offsets, diagonals, off-diagonals, scale factor, and
# conditionally orientation (above). Nothing else -- COMPASS_USE and COMPASS_EXTERNAL
# are configuration, not cal output, and COMPASS_MOT_* come from compassmot, a
# different procedure.
#
# COMPASS_DEV_ID is deliberately NOT pinned even though the cal writes it.
# set_and_save_offsets() -> save_offsets() does
#     _state[id].dev_id.set_and_save(_state[id].detected_dev_id)
# so it is the id of the physical part as detected on that boot, not a property of the
# airframe. It reads 0 whenever the compass is off the bus, so pinning any value makes
# verify.py permanently wrong in one direction or the other. Restoring these numbers
# therefore does NOT make the compass "configured": Compass::configured() compares the
# stored dev_id against the detected one, so the binding still needs a boot with the
# compass attached, or a fresh cal.
#
# Instance 2 carries offsets and a scale but default diagonals and off-diagonals --
# that is what was in the export, not an omission here.
#
# provenance: instance 1 from the on-vehicle cal exported in 943837b 2026-10-27,
# superseding the 3856c84 2026-09-23 values. Instance 2 is unchanged by that cal.
COMPASS_OFS_X,-78.60564
COMPASS_OFS_Y,40.36612
COMPASS_OFS_Z,-17.63679
COMPASS_DIA_X,0.994186
COMPASS_DIA_Y,1.009791
COMPASS_DIA_Z,1.045338
COMPASS_ODI_X,6.181582E-05
COMPASS_ODI_Y,0.03565602
COMPASS_ODI_Z,0.02892364
COMPASS_SCALE,1.043067
COMPASS_OFS2_X,173.6031
COMPASS_OFS2_Y,-115.2469
COMPASS_OFS2_Z,-1.972043
COMPASS_DIA2_X,1
COMPASS_DIA2_Y,1
COMPASS_DIA2_Z,1
COMPASS_ODI2_X,0
COMPASS_ODI2_Y,0
COMPASS_ODI2_Z,0
COMPASS_SCALE2,0.8551114
