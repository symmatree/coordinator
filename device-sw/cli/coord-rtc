#!/usr/bin/env python3
"""Read and configure the DS3234 that drives the PPS line (#11).

    coord-rtc status        what the chip holds and whether the 1 Hz output is on
    coord-rtc enable-pps    turn the 1 Hz square wave on, and verify it took
    coord-rtc systohc       set the chip's time -- RE-PHASES PPS, see below
    coord-rtc hctosys       set the system clock from the chip
    coord-rtc feed          serve the chip to chrony as a SOCK refclock, forever

The chip is on /dev/spidev0.0 because the kernel driver is deliberately not bound
to it: rtc-ds3232 sets INTCN on every probe, which switches INT/SQW from square
wave to alarm output. The reasoning and the source are on #11. The consequence
here is that enabling the square wave is ours to do.

Reports and does not judge, like coord-version: a chip with its output off is an
answer, and the exit code says whether the probe ran.
"""

from __future__ import annotations

import calendar
import ctypes
import os
import socket
import fcntl
import math
import struct
import sys
import time

SPIDEV = "/dev/spidev0.0"

# Mode 3. The DS3234 supports modes 1 and 3 only, and rtc-ds3232 picks 3
# (`spi->mode = SPI_MODE_3` in ds3234_probe), so 3 is the tested one.
SPI_MODE = 3
# The datasheet ceiling is 4 MHz. Nothing here is more than a handful of bytes
# per boot, so there is no reason to go near it.
SPI_HZ = 1_000_000

# Writes address the register with bit 7 set; reads use it bare. Same convention
# the kernel driver encodes as `.write_flag_mask = 0x80`.
WRITE = 0x80

REG_SECONDS = 0x00
REG_CONTROL = 0x0E
REG_STATUS = 0x0F

# Control register bits.
CR_nEOSC = 0x80  # 1 = oscillator stopped on battery
CR_BBSQW = 0x40  # 1 = square wave continues on battery
CR_CONV = 0x20  # temperature conversion, write-only trigger
CR_RS = 0x18  # RS2:RS1, the square-wave rate
CR_INTCN = 0x04  # 1 = pin is an alarm output, 0 = pin is the square wave
CR_A2IE = 0x02
CR_A1IE = 0x01

SQW_RATES = {0x00: "1Hz", 0x08: "1.024kHz", 0x10: "4.096kHz", 0x18: "8.192kHz"}

# INTCN=0 selects the square wave, RS2:RS1=00 selects 1 Hz, the oscillator runs
# and both alarms are off. This is the value the PPS line needs.
CR_PPS = 0x00

SR_OSF = 0x80  # oscillator has stopped since it was last cleared

# Sleep to this long before the target second, then spin. sleep() resolution is
# milliseconds and the write has to land ON the boundary, not near it: the write
# instant is what sets the 1 Hz phase. One spin of a few ms, once, at the operator's
# request -- the achieved error is measured and printed rather than assumed.
SPIN_LEAD_S = 0.003

# chrony's SOCK refclock. struct sock_sample from chrony's refclock_sock.c:
# struct timeval tv; double offset; int pulse; int leap; int _pad; int magic.
# 40 bytes on a 64-bit target, which is what the "=" format gives.
SOCK_MAGIC = 0x534F434B
SOCK_SAMPLE = "=qqdiiii"
# The deployed path comes from the unit's Environment=, which the chrony role
# templates from the same variable as the drop-in -- so the sender and the listener
# cannot disagree. This default is only for a run by hand.
CHRONY_SOCK = os.environ.get("COORD_RTC_CHRONY_SOCK", "/run/chrony.ds3234.sock")
#
# NOT the sample period. THE PULSE PACES THE LOOP: each pass waits for the next edge, so
# samples go out at exactly 1 Hz without anything here deciding that. This is only how
# long to wait before trying again when a pass produced nothing -- no edge, a socket that
# will not take the sample, or just after a chip write, where the point is to let the
# re-phased 1 Hz settle before sampling it.
RETRY_PERIOD_S = float(os.environ.get("COORD_RTC_RETRY_PERIOD_S", "1"))

# Where coordinator-mavlink publishes the current FC-measured offset from UTC:
# "offset_us rtt_us local_us". Used ONLY to correct the chip's epoch while disarmed --
# never as chrony's reference, which is always the chip itself.
FC_TIME_FILE = os.environ.get("COORD_RTC_FC_TIME_FILE",
                              "/var/lib/coordinator/ipc/fc_time")
# A sample whose local reading is further than this from the current clock is not
# usable. The file outlives a reboot, so a previous flight's sample would otherwise be
# applied as if it were current.
FC_MAX_AGE_S = 300.0
# The arm flag the router publishes. The chip is only ever written while disarmed: the
# write resets the countdown chain, which re-phases the 1 Hz and makes one second the
# wrong length, and that is what the cameras are aligning against.
ARM_FILE = os.environ.get("COORD_RTC_ARM_FILE", "/var/lib/coordinator/ipc/fc_armed")
# Correct the epoch when it is off by more than this. Debounce, not precision: each
# correction re-phases the pulse, so it must not happen repeatedly. At the chip's
# 2 ppm, 100 ms accumulates in about 14 hours -- so a bench session or a flying day
# sees roughly one correction, during pre-arm, and then nothing.
FC_CORRECT_OVER_S = float(os.environ.get("COORD_RTC_CORRECT_OVER_S", "0.1"))

# THE SECOND BOUNDARY COMES OFF THE PULSE. The chip has no sub-second register, so a
# plain read says "it is second N" with a whole second of ambiguity -- the same size as
# the window chrony folds a PPS into. But that boundary is already on a wire: the 1 Hz's
# falling edge IS the rollover (DS3234 datasheet p11), the overlay is configured
# assert_falling_edge=1, and the kernel timestamps it. So the instant is the kernel's, to
# microseconds, and all this has to do is read the label that goes with it.
#
# sysfs rather than the PPS_FETCH ioctl on /dev/pps0: a plain read contends with nothing,
# and chronyd holds that device open as a refclock.
PPS_ASSERT_FILE = os.environ.get("COORD_RTC_PPS_ASSERT", "/sys/class/pps/pps0/assert")
# How often to check whether a new edge has been stamped. This does NOT bound the
# sample's error -- the timestamp is the kernel's, and noticing it late costs nothing. It
# only has to be quick enough to read the chip inside the second the edge started.
PPS_WATCH_POLL_S = 0.05
# Read the chip within this much of the edge. Past it the register may have rolled again
# and the label would belong to the next second -- the one failure mode of pairing a
# timestamp taken by someone else with a value read by us.
PPS_LABEL_WINDOW_S = 0.4

# struct spi_ioc_transfer, 32 bytes. Field order and widths are the kernel's.
XFER = "=QQIIHBBBBBB"
SPI_IOC_WR_MODE = 0x40016B01
SPI_IOC_WR_BITS_PER_WORD = 0x40016B03
SPI_IOC_WR_MAX_SPEED_HZ = 0x40046B04


def spi_ioc_message(n: int) -> int:
    """SPI_IOC_MESSAGE(n) carries the transfer count in the ioctl size field."""
    return (1 << 30) | ((n * struct.calcsize(XFER)) << 16) | (ord("k") << 8)


class SpidevBus:
    """One full-duplex transfer per call. The seam the tests replace."""

    def __init__(self, path: str = SPIDEV, mode: int = SPI_MODE, hz: int = SPI_HZ):
        self.f = open(path, "r+b", buffering=0)
        self.hz = hz
        fcntl.ioctl(self.f, SPI_IOC_WR_MODE, struct.pack("=B", mode))
        fcntl.ioctl(self.f, SPI_IOC_WR_BITS_PER_WORD, struct.pack("=B", 8))
        fcntl.ioctl(self.f, SPI_IOC_WR_MAX_SPEED_HZ, struct.pack("=I", hz))

    def transfer(self, tx: bytes) -> bytes:
        txb = ctypes.create_string_buffer(tx, len(tx))
        rxb = ctypes.create_string_buffer(len(tx))
        msg = struct.pack(
            XFER, ctypes.addressof(txb), ctypes.addressof(rxb),
            len(tx), self.hz, 0, 8, 0, 0, 0, 0, 0,
        )
        fcntl.ioctl(self.f, spi_ioc_message(1), msg)
        return rxb.raw

    def close(self) -> None:
        self.f.close()


class Ds3234:
    def __init__(self, bus):
        self.bus = bus

    def read(self, reg: int, n: int = 1) -> bytes:
        return self.bus.transfer(bytes([reg]) + bytes(n))[1:]

    def write(self, reg: int, val: int) -> None:
        self.bus.transfer(bytes([reg | WRITE, val]))

    def enable_pps(self) -> int:
        """Write the square-wave configuration and return what reads back."""
        self.write(REG_CONTROL, CR_PPS)
        return self.read(REG_CONTROL)[0]

    def write_time(self, regs: bytes) -> None:
        """All seven time registers in ONE transfer.

        One transfer because the datasheet wants the time registers written within a
        second of each other, and because writing the seconds register resets the
        chip's countdown chain -- so the instant this lands sets the phase of the
        1 Hz output, not just the labels.
        """
        self.bus.transfer(bytes([REG_SECONDS | WRITE]) + regs)

    def clear_osf(self) -> int:
        """Clear the oscillator-stop flag, preserving the rest of the register.

        Only meaningful once the time has been set: OSF is the chip saying its time
        cannot be trusted, so clearing it is the claim that it now can.
        """
        sr = self.read(REG_STATUS)[0]
        self.write(REG_STATUS, sr & ~SR_OSF)
        return self.read(REG_STATUS)[0]


def bcd(b: int, mask: int = 0x7F) -> int:
    b &= mask
    return (b >> 4) * 10 + (b & 0x0F)


def to_bcd(v: int) -> int:
    return ((v // 10) << 4) | (v % 10)


def time_regs(tm: time.struct_time) -> bytes:
    """The seven time registers for a UTC struct_time.

    UTC, because the chip has no timezone and whatever writes it and whatever reads
    it have to agree. 24-hour mode: bit 6 of the hours register clear.

    Century bit is in the month register. tm_wday is Monday=0 in Python and the chip
    wants 1-7, which nothing reads -- it is written for completeness.
    """
    year = tm.tm_year - 2000
    century = 0x80 if year >= 100 else 0x00
    return bytes([
        to_bcd(tm.tm_sec),
        to_bcd(tm.tm_min),
        to_bcd(tm.tm_hour),
        tm.tm_wday + 1,
        to_bcd(tm.tm_mday),
        to_bcd(tm.tm_mon) | century,
        to_bcd(year % 100),
    ])


def decode_control(cr: int) -> str:
    pin = "square-wave" if not cr & CR_INTCN else "alarm-output"
    rate = SQW_RATES[cr & CR_RS]
    osc = "stopped-on-battery" if cr & CR_nEOSC else "running"
    alarms = [n for n, bit in (("A1", CR_A1IE), ("A2", CR_A2IE)) if cr & bit]
    return (
        f"pin={pin} rate={rate} osc={osc} "
        f"bbsqw={'on' if cr & CR_BBSQW else 'off'} "
        f"alarms={','.join(alarms) if alarms else 'none'}"
    )


def decode_time(regs: bytes) -> str:
    """ISO-ish, from the chip's own registers. No timezone: the chip has none."""
    sec, minute, hour_r, _day, date, month_r, year = regs[:7]
    if hour_r & 0x40:  # 12-hour mode
        hour = bcd(hour_r, 0x1F)
        if hour_r & 0x20:
            hour = (hour % 12) + 12
    else:
        hour = bcd(hour_r, 0x3F)
    century = 2000 + (100 if month_r & 0x80 else 0)
    return (
        f"{century + bcd(year):04d}-{bcd(month_r, 0x1F):02d}-{bcd(date):02d}"
        f"T{hour:02d}:{bcd(minute):02d}:{bcd(sec):02d}"
    )


def cmd_status(rtc: Ds3234) -> int:
    cr = rtc.read(REG_CONTROL)[0]
    sr = rtc.read(REG_STATUS)[0]
    print(f"control  0x{cr:02x}  {decode_control(cr)}")
    print(f"status   0x{sr:02x}  osf={'set' if sr & SR_OSF else 'clear'}")
    print(f"time     {decode_time(rtc.read(REG_SECONDS, 7))}")
    if sr & SR_OSF:
        print("         osf is set: the oscillator stopped, so the time above is not")
        print("         to be trusted until something writes it.")
    if cr & CR_INTCN or cr & CR_RS:
        print(f"         the pin is not producing 1 Hz; `coord-rtc enable-pps` sets 0x{CR_PPS:02x}")
    return 0


def cmd_enable_pps(rtc: Ds3234) -> int:
    got = rtc.enable_pps()
    print(f"control  0x{got:02x}  {decode_control(got)}")
    if got != CR_PPS:
        print(f"wrote 0x{CR_PPS:02x} to the control register and read back 0x{got:02x}",
              file=sys.stderr)
        return 1
    return 0


def fc_offset(path: str = FC_TIME_FILE, max_age_s: float = FC_MAX_AGE_S):
    """The FC-measured offset of this box's clock from UTC, or None.

    Returns (offset_s, rtt_s). Rejected when stale: the file is on disk and survives a
    reboot, so a previous flight's sample would otherwise be applied as if current.
    """
    try:
        with open(path) as f:
            offset_us, rtt_us, local_us = (int(x) for x in f.readline().split()[:3])
    except (OSError, ValueError):
        return None
    if abs(time.time() - local_us / 1e6) > max_age_s:
        return None
    return offset_us / 1e6, rtt_us / 1e6


def armed(path: str = ARM_FILE) -> bool:
    """The router's arm flag. Unreadable counts as ARMED.

    Deliberately the pessimistic default: the only thing this gates is writing the
    chip, and doing that during capture re-phases the signal the cameras align to. Not
    knowing is not a reason to risk it.
    """
    try:
        with open(path) as f:
            return f.readline().strip() != "0"
    except OSError:
        return True


def should_set_chip(no_epoch: bool, chip_error: float | None, is_armed: bool) -> bool:
    """Whether to write the chip's time registers this round.

    Its own function because it is the whole safety argument in one place: a write
    re-phases the 1 Hz and makes one second the wrong length, and that signal is what
    libcamera's SyncMode aligns the pods' shutters against. So:

      armed            -> never, whatever the error
      no FC sample     -> never; nothing else here knows the time of day
      chip has no epoch-> always, there is no phase worth protecting yet
      otherwise        -> only past the debounce, so it is about once per bench
                          session during pre-arm rather than repeatedly

    The FC is the only source. A chip that has never been set -- a new part, or a new
    cell -- gets its first epoch from `coord-rtc systohc` by hand, once, so that the
    first fix is a sub-second correction instead of a 26-year one.

    WHY THE ARM FILE IS THE RIGHT SIGNAL, not merely an available one. pod-link's
    publisher on the coordinator "watches the arm file the MAVLink router already writes
    and publishes it as capture intent" -- so fleet-wide capture intent IS this file,
    and gating on it gates on the same value the pods act on. There is no second signal
    to consult.

    The constraint that follows, and it belongs on #42: whatever implements disarmed
    bench capture has to flow through this same file. A path that publishes intent
    directly would leave two things both meaning "capture" that can disagree, and this
    gate would be reading the wrong one.

    The debounce is a policy choice, not a constraint. chrony does not force a cadence:
    its 0.4 s PPS_LOCK_LIMIT compares the pulse against the locked reference, and the
    reference IS this chip, so the chip's error against UTC never enters that
    comparison and could be a year without chrony noticing. What the cadence is sized
    for is Seth's "the typical pre-arm period has one such reset" -- 100 ms is ~14 h of
    2 ppm drift, so a flying day gets one correction before arming.

    `chip_error` is the CHIP's error against the FC, which is the quantity the decision
    is about. An earlier version passed our clock's offset from the FC instead, which is
    the same number only while chronyd is up and converged onto this chip. Before chrony
    has stepped at boot, or with chronyd stopped, our clock and the chip are independently
    wrong, the debounce reads a number about the wrong device, and whether the chip gets
    corrected turns on the state of a daemon that has nothing to do with it.
    """
    if is_armed or chip_error is None:
        return False
    return no_epoch or abs(chip_error) > FC_CORRECT_OVER_S


def pps_assert(path: str | None = None) -> tuple[float, int] | None:
    """The kernel's timestamp and sequence number for the last captured edge.

    `/sys/class/pps/pps0/assert` reads as `<secs>.<nsecs>#<seq>`. None if the file is
    absent (no pps-gpio) or empty (the device exists and has never seen an edge, which is
    what an unsoldered leg looks like).
    """
    try:
        with open(path or PPS_ASSERT_FILE) as fh:
            raw = fh.read().strip()
    except OSError:
        return None
    if not raw or "#" not in raw:
        return None
    stamp, _, seq = raw.partition("#")
    try:
        return float(stamp), int(seq)
    except ValueError:
        return None


def pulse_boundary(rtc: Ds3234, deadline_s: float = 2.0,
                   path: str | None = None) -> tuple[int, float] | None:
    """Wait for the chip's second boundary on the 1 Hz, then read the label.

    The division of labour is the whole point: the INSTANT is the kernel's timestamp of
    the falling edge, which is the rollover, and the VALUE is one register read
    afterwards. Noticing the edge late does not degrade the sample -- `at` is not our
    reading of the clock -- so this can watch lazily. It only has to read the chip before
    the next rollover, or the label would belong to the following second.

    None when no edge arrives, which is the unsoldered-leg case and the caller's cue to
    fall back to chasing the register.
    """
    first = pps_assert(path)
    if first is None:
        return None
    give_up = time.time() + deadline_s
    while time.time() < give_up:
        time.sleep(PPS_WATCH_POLL_S)
        latest = pps_assert(path)
        if latest is None or latest[1] == first[1]:
            continue
        at = latest[0]
        if time.time() - at > PPS_LABEL_WINDOW_S:
            # Too late to be sure which second the register holds. Wait for the next
            # edge rather than send a label that could be a whole second wrong.
            first = latest
            continue
        regs = rtc.read(REG_SECONDS, 7)
        stamp = decode_time(regs)
        return calendar.timegm(time.strptime(stamp, "%Y-%m-%dT%H:%M:%S")), at
    return None


def sock_sample(chip_s: int, at: float) -> bytes:
    """One struct sock_sample: at system time `at`, the chip read second `chip_s`.

    offset is true-minus-system per chrony's own comment, where "true" here is the
    chip's time base -- which is the base everything on this vehicle shares.
    """
    return struct.pack(
        SOCK_SAMPLE, int(at), int((at % 1) * 1e6),
        chip_s - at, 0, 0, 0, SOCK_MAGIC,
    )


def cmd_feed(rtc: Ds3234) -> int:
    """Serve the chip to chrony as its seconds source, until killed.

    THE REFERENCE IS THE CHIP, NOT UTC, AND THAT IS THE WHOLE TRICK. One chip generates
    both the seconds label and the pulse, so they cannot disagree. The sample is taken
    at the chip's seconds rollover, which is the same instant as the falling edge of the
    1 Hz -- so chrony's reference and the pulse it is locked to are the SAME CLOCK and
    agree by construction. There is no phase difference between them to drift, and
    chrony's 0.4 s locked-PPS tolerance is never approached.

    The same fact is why correcting the chip is coherent rather than disruptive: setting
    the RTC moves the label and the edge together, and every consumer takes the same
    buffered copy of that edge, so they all step at the same instant by the same amount.
    It is a common-mode step, not a divergence. Disarmed, nothing is aligned to the tick
    and nobody cares; armed, the cameras are mid-loop, which is why it is gated.

    Reporting UTC here instead would make the reference a different clock from the
    pulse, and their difference -- the chip's arbitrary phase against the UTC second --
    would drift at the chip's 2 ppm until chrony discarded every pulse. UTC is a label
    on this time base, not the base itself; coordinator-mavlink logs the FC's
    GPS-derived offset per flight for that.

    What this buys is what the circuit is for: every pod's clock locked to one physical
    edge, so libcamera's SyncMode converges the shutters, and any error in the edge's
    absolute position is common-mode across every consumer and cancels.

    THE EPOCH IS CORRECTED FROM THE FC, WHILE DISARMED. The FC's GPS-derived time is
    the only thing here that knows what time of day it is, so it sets the chip -- and
    the chip then sets chrony. Writing the chip re-phases the pulse, so it happens only
    while disarmed, and only when the error exceeds a debounce, which at 2 ppm means
    roughly once per bench session during pre-arm rather than repeatedly.

    pulse=0: we supply whole seconds, which is exactly what the PPS refclock cannot.
    """
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    refused = 0
    sent = 0
    no_edge = 0
    while True:
        edge = pulse_boundary(rtc)
        if edge is None:
            # No edge means the signal this whole design rests on is not arriving. There
            # is nothing useful to send without it -- the chip's label on its own leaves
            # a second of ambiguity, which is the error size chrony cannot absorb. Said
            # on the same schedule as a refused socket, because at this period saying it
            # every pass would be the only thing in the journal.
            no_edge += 1
            if no_edge in (1, 10) or no_edge % 100 == 0:
                print(f"no edge on the 1 Hz at {PPS_ASSERT_FILE}, so there is nothing to "
                      f"tell chrony ({no_edge} so far)", file=sys.stderr)
            time.sleep(RETRY_PERIOD_S)
            continue

        chip_s, at = edge
        no_epoch = bool(rtc.read(REG_STATUS)[0] & SR_OSF)

        # Correct the chip from the FC. Unconditional when the chip has no epoch at
        # all: nothing downstream works until it does, and there is no pulse phase
        # worth protecting yet.
        fc = fc_offset()
        offset = fc[0] if fc is not None else None
        # What the chip is wrong BY, which is what the debounce is about. offset is how
        # far trusted time is from our clock; chip_s is what the chip read at `at`.
        chip_error = None if offset is None else chip_s - (at + offset)
        if should_set_chip(no_epoch, chip_error, armed()):
            target, err, sr = set_chip(rtc, offset)
            stamp = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(target))
            print(f"coord-rtc: set the chip to {stamp}Z from the FC "
                  f"(chip was off {chip_error:+.3f} s, landed {err * 1000:+.1f} ms, "
                  f"status 0x{sr:02x}); the 1 Hz is re-phased", flush=True)
            time.sleep(RETRY_PERIOD_S)
            continue

        if no_epoch:
            # The label is meaningless -- the chip reads 2000-01-01 and the offset
            # would be about -26 years. Send nothing rather than that; the FC will fix
            # it when it has a fix and we are disarmed, or `systohc` will by hand.
            if refused == 0:
                print("coord-rtc: chip has no epoch (osf set) and no usable FC sample, "
                      "so there is nothing to tell chrony yet", file=sys.stderr)
            refused += 1
        else:
            try:
                sock.sendto(sock_sample(chip_s, at), CHRONY_SOCK)
            except (FileNotFoundError, ConnectionRefusedError):
                # chrony not up yet, or not configured with this refclock. Not fatal:
                # the next sample will land.
                refused += 1
                if refused in (1, 10) or refused % 100 == 0:
                    print(f"{CHRONY_SOCK} not accepting samples ({refused} so far)",
                          file=sys.stderr)
            else:
                # Once, on the first sample that lands. Without it the journal for this
                # unit is a single systemd "Started" line and then silence, which reads
                # exactly like a feed that is doing nothing -- it cost a wrong diagnosis
                # on the first boot that had a good epoch. Not per sample: that would be
                # a line a minute forever to say nothing changed.
                sent += 1
                if sent == 1:
                    stamp = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(chip_s))
                    print(f"coord-rtc: feeding chrony from the chip, {stamp}Z, "
                          f"{chip_s - at:+.3f} s from this clock, once per pulse",
                          flush=True)
        # NO SLEEP HERE. The next pass blocks on the next edge, which paces this at
        # 1 Hz by construction. Sleeping as well made it 2 s -- the edge wait PLUS the
        # period -- which is half the samples chrony needs per poll.


def set_system(ts: float) -> None:
    """The seam the tests replace, so no test can move this machine's clock."""
    time.clock_settime(time.CLOCK_REALTIME, ts)


def set_chip(rtc: Ds3234, offset: float = 0.0) -> tuple[int, float, int]:
    """Write the chip, landing on a second boundary of (system clock + offset).

    The chip has no sub-second register, so the fraction cannot be written as a
    value -- it is carried by WHEN the write lands, because writing the seconds
    register resets the countdown chain. The second comes from the registers, the
    phase comes from the timing.

    `offset` is how far the true time is from this box's clock, which is zero for
    `systohc` and the GPS correction when one is being applied. Returns the second
    claimed, the error in seconds, and the status register after clearing OSF.

    WHAT THE CONSUMERS SEE AROUND THIS WRITE IS NOT A CLEAN STEP. The datasheet says
    the output "transitions high 500ms after the seconds data transfer" and says
    nothing about its state in between, so depending on where in its cycle the write
    lands (flight-hardware, from p11):

      - a runt pulse, a high or low period much shorter than 500 ms, if the output was
        mid-cycle when the chain reset
      - a missing edge, if the output was already high and simply stays high until the
        +500 ms transition, so there is no transition to see
      - or nothing unusual, if the write landed near a natural boundary

    All three are electrically ordinary and the buffer passes any of them faithfully.
    The consequences are at the consumers and are benign, but they look like faults:
    pps-gpio timestamps a runt edge as an ordinary assert, so chrony sees an interval
    that is neither 1 s nor a clean step; the FC's feedback ISR counts edges, so a runt
    is an extra CAM record and a missing edge is a gap. Written down rather than
    designed around, so that a 0.3 s interval in the journal next to a correction is
    recognised instead of chased.

    Not worth optimising: the disturbance is the size of the phase correction, which is
    the error being fixed, so there is no landing instant that avoids it.
    """
    target = math.floor(time.time() + offset) + 2
    regs = time_regs(time.gmtime(target))
    # The boundary in terms of the clock this process can actually read.
    fire = target - offset
    delay = fire - time.time() - SPIN_LEAD_S
    if delay > 0:
        time.sleep(delay)
    while time.time() < fire:
        pass
    rtc.write_time(regs)
    landed = time.time()
    return target, landed - fire, rtc.clear_osf()


def cmd_systohc(rtc: Ds3234) -> int:
    """Set the chip from the system clock. Reports the achieved error.

    THIS RE-PHASES THE PPS LINE AND MAKES ONE SECOND THE WRONG LENGTH. Writing the
    seconds register resets the countdown chain, and every consumer of the 1 Hz sees
    it: chrony takes a phase step, and the campods align capture by adjusting the
    camera blanking interval against this signal. Run it on the ground, with capture
    stopped, where the short second lands with nothing aligned to it.

    It exists for a chip that has no usable time at all -- OSF set, reading 2000-01-01,
    which is a fresh cell. In normal operation nothing calls it.
    """
    target, err, sr = set_chip(rtc)
    err_ms = err * 1000
    print(f"wrote    {time.strftime('%Y-%m-%dT%H:%M:%S', time.gmtime(target))}Z")
    print(f"landed   {err_ms:+.1f} ms from the second it claims")
    print(f"status   0x{sr:02x}  osf={'set' if sr & SR_OSF else 'clear'}")
    if sr & SR_OSF:
        print("osf did not clear, so the chip still reports its time as unreliable",
              file=sys.stderr)
        return 1
    return 0


def cmd_hctosys(rtc: Ds3234) -> int:
    """Set the system clock from the chip.

    Refuses while OSF is set. That flag is the chip saying its time cannot be
    trusted, and a Pi 4B has no other RTC -- so believing it would replace a clock
    that is merely wrong with one that is wrong and looks deliberate.
    """
    sr = rtc.read(REG_STATUS)[0]
    if sr & SR_OSF:
        print(f"status 0x{sr:02x} has osf set: the chip's time is not trustworthy, so "
              "the system clock is left alone. `coord-rtc systohc` sets the chip.",
              file=sys.stderr)
        return 1
    regs = rtc.read(REG_SECONDS, 7)
    stamp = decode_time(regs)
    ts = calendar.timegm(time.strptime(stamp, "%Y-%m-%dT%H:%M:%S"))
    before = time.time()
    try:
        set_system(float(ts))
    except PermissionError:
        print("setting the system clock needs root.", file=sys.stderr)
        return 1
    print(f"chip     {stamp}Z")
    print(f"system   moved {ts - before:+.1f} s")
    return 0


COMMANDS = {
    "status": cmd_status,
    "enable-pps": cmd_enable_pps,
    "systohc": cmd_systohc,
    "hctosys": cmd_hctosys,
    "feed": cmd_feed,
}


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[1] not in COMMANDS:
        print(f"usage: {argv[0]} {{{' | '.join(COMMANDS)}}}", file=sys.stderr)
        return 2
    try:
        bus = SpidevBus()
    except FileNotFoundError:
        print(f"{SPIDEV} does not exist. SPI comes from device tree, so the image "
              "needs dtparam=spi=on (see coordinator#11).", file=sys.stderr)
        return 1
    except PermissionError:
        print(f"cannot open {SPIDEV}; run this as root.", file=sys.stderr)
        return 1
    try:
        return COMMANDS[argv[1]](Ds3234(bus))
    finally:
        bus.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
