#!/usr/bin/env python3
"""Push a set of .param files to the flight controller, over the link we already have.

    tar -C ardupilot/inputs -c . | ssh pi@coordinator 'sudo coord fc-params push' \
        > ardupilot/rekon10-methodi.param

The tarball comes in on stdin; every `*.param` member in it is read, in name order, and
every KEY,VALUE line is sent to the FC once as PARAM_SET. ONE PASS, no ordering and no
fix point: a parameter that only exists after another is enabled, or after a reboot, is
reported as not existing, and whoever ran this decides whether to run it again.

Each set waits for the FC's answer -- PARAM_VALUE with that name, or PARAM_ERROR -- with
Mission Planner's retry (3 resends, 700 ms apart). What counts as a complaint, each one a
JSON line on stderr:

  error      the FC sent PARAM_ERROR (does not exist, permission denied, out of range)
  mismatch   it answered with a value other than the one sent, compared to the decimal
             places the value is written with (40.36612 to 5): the answer to a set has
             come back a few float32 steps off a value the read-back then shows was kept
  no-reply   nothing came back for that name

THEN THE EXPORT, on stdout: every parameter the FC has, read back after the pass, in the
format Mission Planner's Save to File writes -- its sort order and its number formatting --
so it can replace rekon10-methodi.param and a diff of it shows only what changed.

Exit 0 with no complaints, 1 with any (the export is still written), 2 when the input is
unusable, 3 when the read-back did not get every parameter (nothing on stdout: a partial
export would read as parameters removed).

Values go as float, which is how PARAM_SET carries them and how every GCS has always
sent them.

THE PORT MUST BE FREE. coordinator-mavlink holds /dev/ttyAMA0 while the stack is up --
stop the stack first, as for `coord fc-log`.

WHY THIS RUNS IN A CONTAINER, and the image it borrows, are coord-fc-log's: pymavlink is
in the coordinator-mavlink image and not on the host.
"""

from __future__ import annotations

import decimal
import importlib.machinery
import importlib.util
import json
import os
import shutil
import struct
import sys
import tarfile
import time

DEVICE = os.environ.get("COORD_FC_DEVICE", "/dev/ttyAMA0")
BAUD = int(os.environ.get("COORD_FC_BAUD", "1500000"))
# coord-fc-log's identity, for the same reason: not the FC, not a GCS.
SRC_SYSTEM = 250
SRC_COMPONENT = 1
# Mission Planner's setParam: resend after 700 ms, three times.
REPLY_S = 0.7
RESENDS = 3
# The read-back: a listing that has gone this long without a new index is asked for its
# missing ones, this many at a time, for this many rounds that recover nothing.
QUIET_S = 1.0
MAX_REREADS = 50
MAX_DEAD_ROUNDS = 5


def _fc_log():
    """coord-fc-log, for the image lookup. It sits beside this script on the host."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "coord-fc-log")
    spec = importlib.util.spec_from_loader(
        "coord_fc_log", importlib.machinery.SourceFileLoader("coord_fc_log", path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def reexec_in_container() -> "None":
    """Re-run inside the mavlink image, as coord-fc-log does, with stdin passed through.

    -i is what carries the tarball in; without it podman gives the container no stdin.
    """
    if shutil.which("podman") is None:
        sys.exit("coord-fc-params: no pymavlink and no podman; cannot reach the FC")
    me = os.path.abspath(__file__)
    cmd = [
        "podman", "run", "--rm", "-i", "--pull", "never", "--entrypoint", "python3",
        "--device", f"{DEVICE}:{DEVICE}",
        "-v", f"{me}:{me}:ro",
        _fc_log().resolve_image(), me,
    ] + sys.argv[1:]
    os.execvp("podman", cmd)


try:
    from pymavlink import mavutil  # noqa: E402
except ImportError:
    mavutil = None
    if __name__ == "__main__":
        reexec_in_container()


def ev(obj: dict) -> None:
    """One JSONL event on stderr. stdout belongs to the export."""
    sys.stderr.write(json.dumps(obj) + "\n")
    sys.stderr.flush()


def decimal_places(text: str) -> int:
    """How many places after the point `text` is written to: 40.36612 is 5, 6.181582E-05 is 11."""
    return max(0, -decimal.Decimal(text).as_tuple().exponent)


def parse_param_text(text: str, source: str) -> "list[tuple[str, float, str, int]]":
    """KEY,VALUE lines, '#' comments, as the fragments and Mission Planner exports are."""
    rows = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        key, sep, val = line.partition(",")
        if not sep:
            raise ValueError(f"{source}:{n}: not KEY,VALUE: {raw!r}")
        val = val.strip()
        rows.append((key.strip(), float(val), f"{source}:{n}", decimal_places(val)))
    return rows


def read_tarball(fh) -> "list[tuple[str, float, str, int]]":
    """Every *.param member of the tar on `fh`, in name order."""
    files = {}
    with tarfile.open(fileobj=fh, mode="r|*") as tar:
        for member in tar:
            if member.isfile() and member.name.endswith(".param"):
                files[member.name] = tar.extractfile(member).read().decode()
    rows = []
    for name in sorted(files):
        rows += parse_param_text(files[name], os.path.basename(name))
    return rows


def as_float32(v: float) -> float:
    """What survives the trip: PARAM_SET and PARAM_VALUE both carry a float32."""
    return struct.unpack("<f", struct.pack("<f", v))[0]


def name_of(msg) -> str:
    pid = msg.param_id
    if isinstance(pid, bytes):
        pid = pid.decode("ascii", "replace")
    return pid.rstrip("\x00")


def set_one(m, key: str, value: float, places: int) -> "dict | None":
    """Send one PARAM_SET and wait for the FC's answer. None when it took the value."""
    want = round(value, places)
    for _ in range(1 + RESENDS):
        m.mav.param_set_send(m.target_system, m.target_component, key.encode(), value,
                             mavutil.mavlink.MAV_PARAM_TYPE_REAL32)
        deadline = time.time() + REPLY_S
        while time.time() < deadline:
            msg = m.recv_match(type=["PARAM_VALUE", "PARAM_ERROR"], blocking=True,
                               timeout=max(0.0, deadline - time.time()))
            if msg is None or name_of(msg) != key:
                continue
            if msg.get_type() == "PARAM_ERROR":
                return {"complaint": "error",
                        "error": mavutil.mavlink.enums["MAV_PARAM_ERROR"][msg.error].name}
            if round(msg.param_value, places) != want:
                return {"complaint": "mismatch", "fc": msg.param_value}
            return None
    return {"complaint": "no-reply"}


def push(m, rows) -> int:
    """The one pass. Returns the number of complaints."""
    complaints = 0
    for key, value, where, places in rows:
        got = set_one(m, key, value, places)
        if got is not None:
            complaints += 1
            ev({"param": key, "sent": value, "at": where, **got})
    ev({"event": "pushed", "params": len(rows), "complaints": complaints})
    return complaints


def read_all(m) -> "dict[str, float] | None":
    """Every parameter the FC has, or None if some never arrived.

    PARAM_REQUEST_LIST, then each index still missing once the stream goes quiet asked
    for by PARAM_REQUEST_READ. A PARAM_VALUE is placed by its index against the count it
    carries; anything without a valid index (the broadcast after a set) is not part of
    the listing.
    """
    m.mav.param_request_list_send(m.target_system, m.target_component)
    have: "dict[int, tuple[str, float]]" = {}
    count = None
    last_new = time.time()
    dead = 0
    while True:
        msg = m.recv_match(type="PARAM_VALUE", blocking=True, timeout=QUIET_S / 4)
        if msg is not None and 0 <= msg.param_index < msg.param_count:
            count = msg.param_count
            if msg.param_index not in have:
                last_new = time.time()
                dead = 0
            have[msg.param_index] = (name_of(msg), msg.param_value)
            continue
        if time.time() - last_new < QUIET_S:
            continue
        missing = [] if count is None else sorted(set(range(count)) - set(have))
        if count is not None and not missing:
            return {name: value for name, value in have.values()}
        dead += 1
        if dead > MAX_DEAD_ROUNDS:
            ev({"event": "error", "message": "the read-back did not complete",
                "params_expected": count, "params_received": len(have)})
            return None
        if count is None:
            m.mav.param_request_list_send(m.target_system, m.target_component)
        for idx in missing[:MAX_REREADS]:
            m.mav.param_request_read_send(m.target_system, m.target_component, b"", idx)
        last_new = time.time()


def export_value(v: float) -> str:
    """A value as Mission Planner's Save to File writes it: integers bare, a float as the
    shortest decimal that is the same float32, exponent as .NET writes it (6.181582E-05)."""
    if v == int(v):
        return str(int(v))
    for digits in range(1, 10):
        s = f"{v:.{digits}g}"
        if as_float32(float(s)) == v:
            break
    return s.replace("e", "E")


def export(params: "dict[str, float]") -> str:
    """The whole set in Mission Planner's order. It sorts with the culture comparer, under
    which `_` comes before digits and letters (ATC_ANG_YAW_P before ATC_ANGLE_BOOST)."""
    return "".join(f"{k},{export_value(as_float32(params[k]))}\n"
                   for k in sorted(params, key=lambda k: k.replace("_", " ")))


def connect():
    os.environ["MAVLINK20"] = "1"
    m = mavutil.mavlink_connection(
        DEVICE, baud=BAUD, source_system=SRC_SYSTEM,
        source_component=SRC_COMPONENT, dialect="ardupilotmega")
    if m.wait_heartbeat(timeout=20) is None:
        sys.exit(f"coord-fc-params: no heartbeat from the FC on {DEVICE}")
    return m


def main() -> int:
    if sys.argv[1:] != ["push"]:
        print("usage: coord fc-params push < params.tar", file=sys.stderr)
        return 2
    try:
        rows = read_tarball(sys.stdin.buffer)
    except (tarfile.TarError, ValueError) as exc:
        print(f"coord-fc-params: {exc}", file=sys.stderr)
        return 2
    if not rows:
        print("coord-fc-params: no KEY,VALUE lines in any *.param on stdin", file=sys.stderr)
        return 2
    m = connect()
    complaints = push(m, rows)
    params = read_all(m)
    if params is None:
        return 3
    sys.stdout.write(export(params))
    sys.stdout.flush()
    ev({"event": "done", "params": len(rows), "complaints": complaints,
        "exported": len(params)})
    return 1 if complaints else 0


if __name__ == "__main__":
    sys.exit(main())
