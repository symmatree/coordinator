#!/usr/bin/env python3
"""Push a set of .param files to the flight controller, over the link we already have.

    tar -C ardupilot/inputs -c . | ssh pi@coordinator 'sudo coord fc-params push'

The tarball comes in on stdin; every `*.param` member in it is read, in name order, and
every KEY,VALUE line is sent to the FC once as PARAM_SET. ONE PASS, no ordering and no
fix point: a parameter that only exists after another is enabled, or after a reboot, is
reported as not existing, and whoever ran this decides whether to run it again.

Each set waits for the FC's answer -- PARAM_VALUE with that name, or PARAM_ERROR -- with
Mission Planner's retry (3 resends, 700 ms apart). What counts as a complaint, each one a
JSON line on stdout:

  error      the FC sent PARAM_ERROR (does not exist, permission denied, out of range)
  mismatch   it answered with a value other than the one sent
  no-reply   nothing came back for that name

then a summary line. Exit 0 with no complaints, 1 with any, 2 when the input is unusable.

Values go as float, which is how PARAM_SET carries them and how every GCS has always
sent them.

THE PORT MUST BE FREE. coordinator-mavlink holds /dev/ttyAMA0 while the stack is up --
stop the stack first, as for `coord fc-log`.

WHY THIS RUNS IN A CONTAINER, and the image it borrows, are coord-fc-log's: pymavlink is
in the coordinator-mavlink image and not on the host.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import shutil
import struct
import sys
import tarfile
import time

DEVICE = os.environ.get("COORD_FC_DEVICE", "/dev/ttyAMA0")
BAUD = int(os.environ.get("COORD_FC_BAUD", "1500000"))
# coord-fc-log's identity, for the same reason: not the FC, not a GCS.
SRC_SYSTEM = 250
SRC_COMPONENT = 1
# Mission Planner's setParam: resend after 700 ms, three times.
REPLY_S = 0.7
RESENDS = 3


def _fc_log():
    """coord-fc-log, for the image lookup. It sits beside this script on the host."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "coord-fc-log")
    spec = importlib.util.spec_from_loader(
        "coord_fc_log", importlib.machinery.SourceFileLoader("coord_fc_log", path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def reexec_in_container() -> "None":
    """Re-run inside the mavlink image, as coord-fc-log does, with stdin passed through.

    -i is what carries the tarball in; without it podman gives the container no stdin.
    """
    if shutil.which("podman") is None:
        sys.exit("coord-fc-params: no pymavlink and no podman; cannot reach the FC")
    me = os.path.abspath(__file__)
    cmd = [
        "podman", "run", "--rm", "-i", "--pull", "never", "--entrypoint", "python3",
        "--device", f"{DEVICE}:{DEVICE}",
        "-v", f"{me}:{me}:ro",
        _fc_log().resolve_image(), me,
    ] + sys.argv[1:]
    os.execvp("podman", cmd)


try:
    from pymavlink import mavutil  # noqa: E402
except ImportError:
    mavutil = None
    if __name__ == "__main__":
        reexec_in_container()


def out(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def parse_param_text(text: str, source: str) -> "list[tuple[str, float, str]]":
    """KEY,VALUE lines, '#' comments, as the fragments and Mission Planner exports are."""
    rows = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        key, sep, val = line.partition(",")
        if not sep:
            raise ValueError(f"{source}:{n}: not KEY,VALUE: {raw!r}")
        rows.append((key.strip(), float(val), f"{source}:{n}"))
    return rows


def read_tarball(fh) -> "list[tuple[str, float, str]]":
    """Every *.param member of the tar on `fh`, in name order."""
    files = {}
    with tarfile.open(fileobj=fh, mode="r|*") as tar:
        for member in tar:
            if member.isfile() and member.name.endswith(".param"):
                files[member.name] = tar.extractfile(member).read().decode()
    rows = []
    for name in sorted(files):
        rows += parse_param_text(files[name], os.path.basename(name))
    return rows


def as_float32(v: float) -> float:
    """What survives the trip: PARAM_SET and PARAM_VALUE both carry a float32."""
    return struct.unpack("<f", struct.pack("<f", v))[0]


def name_of(msg) -> str:
    pid = msg.param_id
    if isinstance(pid, bytes):
        pid = pid.decode("ascii", "replace")
    return pid.rstrip("\x00")


def set_one(m, key: str, value: float) -> "dict | None":
    """Send one PARAM_SET and wait for the FC's answer. None when it took the value."""
    want = as_float32(value)
    for _ in range(1 + RESENDS):
        m.mav.param_set_send(m.target_system, m.target_component, key.encode(), value,
                             mavutil.mavlink.MAV_PARAM_TYPE_REAL32)
        deadline = time.time() + REPLY_S
        while time.time() < deadline:
            msg = m.recv_match(type=["PARAM_VALUE", "PARAM_ERROR"], blocking=True,
                               timeout=max(0.0, deadline - time.time()))
            if msg is None or name_of(msg) != key:
                continue
            if msg.get_type() == "PARAM_ERROR":
                return {"complaint": "error",
                        "error": mavutil.mavlink.enums["MAV_PARAM_ERROR"][msg.error].name}
            if as_float32(msg.param_value) != want:
                return {"complaint": "mismatch", "fc": msg.param_value}
            return None
    return {"complaint": "no-reply"}


def push(m, rows) -> int:
    complaints = 0
    for key, value, where in rows:
        got = set_one(m, key, value)
        if got is not None:
            complaints += 1
            out({"param": key, "sent": value, "at": where, **got})
    out({"event": "done", "params": len(rows), "complaints": complaints})
    return 1 if complaints else 0


def connect():
    os.environ["MAVLINK20"] = "1"
    m = mavutil.mavlink_connection(
        DEVICE, baud=BAUD, source_system=SRC_SYSTEM,
        source_component=SRC_COMPONENT, dialect="ardupilotmega")
    if m.wait_heartbeat(timeout=20) is None:
        sys.exit(f"coord-fc-params: no heartbeat from the FC on {DEVICE}")
    return m


def main() -> int:
    if sys.argv[1:] != ["push"]:
        print("usage: coord fc-params push < params.tar", file=sys.stderr)
        return 2
    try:
        rows = read_tarball(sys.stdin.buffer)
    except (tarfile.TarError, ValueError) as exc:
        print(f"coord-fc-params: {exc}", file=sys.stderr)
        return 2
    if not rows:
        print("coord-fc-params: no KEY,VALUE lines in any *.param on stdin", file=sys.stderr)
        return 2
    return push(connect(), rows)


if __name__ == "__main__":
    sys.exit(main())
