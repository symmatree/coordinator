{
  "name": "fleet-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ground-station control surface for the rekon10 fleet: probe, bootstrap and update the coordinator and campods over SSH.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.4",
    "node-ssh": "13.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/ssh2": "1.15.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
