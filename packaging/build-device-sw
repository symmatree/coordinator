#!/usr/bin/env bash
# Pack the device software into one tarball, so a device fetches a published output
# instead of cloning the repo (#341).
#
#   packaging/build-device-sw <output-dir>
#
# Two directories go in whole: device-sw/cli (installed into /usr/local/bin) and stacks
# (the quadlet units and stack targets). Nothing selects within them -- whatever is in
# device-sw/cli is what a device installs, which is why the repo keeps the tests and the
# README outside it.
set -euo pipefail

out_dir=${1:?usage: packaging/build-device-sw <output-dir>}
repo=$(cd "$(dirname "$0")/.." && pwd)

# Set by the workflow from github.sha / github.ref / the repo URL. Falls back to git for a
# hand run.
version=${PAYLOAD_COMMIT:-$(git -C "$repo" rev-parse HEAD)}
# FLEET_SOURCE_REF is fully qualified -- refs/heads/main, not main. github.ref already is;
# see docs/build-and-provenance.md for why the abbreviated spelling cannot be used.
ref=${PAYLOAD_REF:-$(git -C "$repo" rev-parse --symbolic-full-name HEAD)}
source=${PAYLOAD_SOURCE:-$(git -C "$repo" config --get remote.origin.url)}

mkdir -p "$out_dir"
out_dir=$(cd "$out_dir" && pwd)
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
root=$stage/device-sw

mkdir -p "$root/cli"
# Files only. cli/ is the install set, so a generated __pycache__ left by a test run is
# in the directory but is not device software.
find "$repo/device-sw/cli" -maxdepth 1 -type f -exec cp {} "$root/cli/" \;
cp -r "$repo/stacks" "$root/stacks"

# The archive has no .git, so this is the only thing that can answer "what is this box
# running". Written in coord-version's vocabulary, so installing the archive means copying
# this file to /etc/fleet-device-sw -- no reformatting, one identity format on the device.
cat >"$root/VERSION" <<VER
ORG_OPENCONTAINERS_IMAGE_SOURCE="$source"
ORG_OPENCONTAINERS_IMAGE_REVISION="$version"
FLEET_SOURCE_REF="$ref"
VER

tarball=$out_dir/device-sw-$version.tar.gz
# Fixed ownership and mtime so the same commit packs to the same bytes.
tar -C "$stage" --numeric-owner --owner=0 --group=0 --sort=name \
	--mtime="@$(git -C "$repo" show -s --format=%ct "$version" 2>/dev/null || echo 0)" \
	-czf "$tarball" device-sw
echo "$tarball"
