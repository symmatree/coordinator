[Unit]
Description=OAK-D feature tracker
PartOf=coordinator-stack.target

[Container]
Image=ghcr.io/symmatree/coordinator-vio-tracker:main
ContainerName=coordinator_vio_tracker
Pull=never
PodmanArgs=--privileged --stop-timeout=30

# A BIND MOUNT of /dev/bus/usb, not AddDevice. When depthai uploads firmware the
# MyriadX resets and re-enumerates to a new USB address and node; a device mapping
# snapshots nodes at container start, so the booted device is invisible and depthai
# reports X_LINK_DEVICE_NOT_FOUND. A bind mount of the directory propagates the new
# node live. privileged opens the device cgroup so the new node is usable.
Volume=/dev/bus/usb:/dev/bus/usb
Volume=/var/lib/coordinator/ipc:/tmp
Volume=/var/lib/coordinator/config:/config:ro
# #72: periodic disparity + RGB stills land here when OAK_CAPTURE_DIR is set.
Volume=/var/lib/coordinator/captures:/captures
Volume=/etc/hostname:/etc/host-hostname:ro

# Enables in-tracker capture alongside VIO. This is the CONTAINER path. Unset it and
# the tracker is byte-for-byte upstream: no color camera, no disk writes.
Environment=OAK_CAPTURE_DIR=/captures
# #88: image capture is gated on FC ARM. coordinator-mavlink writes the arm state to
# this shared file -- both containers mount the IPC dir at /tmp -- so bench and idle
# time do not fill the card with pictures of the desk. The .feat is NOT gated: the
# FC's EKF starts before arm, so replay needs the pre-arm stream.
Environment=OAK_ARM_FILE=/tmp/fc_armed
Environment=OAK_JPEG_QUALITY=92
# Disparity OFF: a VIO-debugging aid, and image writing is implicated in the tracker
# dropping ~half its frames (E31, #156) -- pre-arm 0.0% loss over 539 consecutive
# frames against 53.5% once the arm gate opened. Set to 1.0 for a debugging flight.
Environment=OAK_DISPARITY_HZ=0
Environment=OAK_STILL_HZ=0.2
Environment=OAK_STILL_RESOLUTION=12mp
# In flight the ~30 ms auto-exposure (@ ISO 110) smeared every frame. Cap the shutter
# so AE trades to ISO/gain instead; 0 = no cap.
Environment=OAK_STILL_MAX_EXPOSURE_US=5000
# IMX378 lens/VCM position with AF off: 255 = macro at 8 cm, ~120-130 = infinite
# focus (varies module to module). Mapping subjects are past hyperfocal.
Environment=OAK_STILL_FOCUS=125
# The rectified-LEFT mono frame -- the exact image the feature tracker consumes (#125).
# OFF for the same reason as disparity; 260814 is the only flight with it on disk (E33).
Environment=OAK_MONO_HZ=0
# Caps the MONO AE shutter, which changes the VIO input itself. 0 = no cap.
# Bench-verify feature tracking before trusting a value in flight.
Environment=OAK_MONO_MAX_EXPOSURE_US=0

[Service]
TimeoutStopSec=60
Restart=no

[Install]
WantedBy=coordinator-stack.target
