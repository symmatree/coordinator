# OAK-D feature tracker and in-tracker capture.
[Unit]
Description=OAK-D feature tracker
PartOf=coordinator-stack.target

[Container]
Image=ghcr.io/symmatree/coordinator-vio-tracker:main
ContainerName=coordinator_vio_tracker
Pull=never
PodmanArgs=--privileged --stop-timeout=30

# A bind mount, not AddDevice: the MyriadX re-enumerates to a new node after firmware
# upload, and a device mapping snapshots nodes at container start.
Volume=/dev/bus/usb:/dev/bus/usb
Volume=/var/lib/coordinator/ipc:/tmp
Volume=/var/lib/coordinator/config:/config:ro
Volume=/var/lib/coordinator/captures:/captures
Volume=/etc/hostname:/etc/host-hostname:ro

# Enables in-tracker capture. Unset, the tracker is byte-for-byte upstream.
Environment=OAK_CAPTURE_DIR=/captures
# Image capture is gated on FC arm; coordinator-mavlink writes this file. The .feat is
# not gated -- replay needs the pre-arm stream.
Environment=OAK_ARM_FILE=/tmp/fc_armed
Environment=OAK_JPEG_QUALITY=92
# Disparity and mono are debugging aids. Image writing is implicated in the tracker
# dropping ~half its frames (#156). Set either to 1.0 for a debugging flight.
Environment=OAK_DISPARITY_HZ=0
Environment=OAK_MONO_HZ=0
Environment=OAK_STILL_HZ=0.2
Environment=OAK_STILL_RESOLUTION=12mp
# Shutter caps in us; 0 = uncapped. The mono cap changes the VIO input itself, so
# bench-verify feature tracking before setting it.
Environment=OAK_STILL_MAX_EXPOSURE_US=5000
Environment=OAK_MONO_MAX_EXPOSURE_US=0
# IMX378 lens position, AF off: 255 = macro at 8 cm, ~120-130 = infinity.
Environment=OAK_STILL_FOCUS=125

[Service]
TimeoutStopSec=60
Restart=no

[Install]
WantedBy=coordinator-stack.target
