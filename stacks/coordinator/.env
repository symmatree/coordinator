# Coordinator stack config -- git-authoritative. Do NOT hand-edit the deployed copy on the
# Pi: config lives here in git, and the deploy overwrites the on-box copy (drift trap, #48).
# Change a value here and redeploy. Runtime behaviour changes go through the command channel,
# not this file. See docs/deployment-model.md. Do not commit secrets here.
HOSTNAME=coordinator

# Image tags (images ship in a follow-up PR)
VIO_TRACKER_VERSION=main
VIO_ESTIMATOR_VERSION=main
MAVLINK_VERSION=main
OAK_STILL_CAPTURE_VERSION=main
SH1106_DISPLAY_VERSION=main

# Shared Unix socket dir (bind-mounted as /tmp in vision + mavlink containers)
COORDINATOR_IPC_DIR=/var/lib/coordinator/ipc

# Host path mounted read-only as /config (oak_d.yaml, etc.)
COORDINATOR_CONFIG_DIR=/var/lib/coordinator/config

# Host path for OAK-D captures (stills + disparity), mounted as /captures (#72)
COORDINATOR_CAPTURES_DIR=/var/lib/coordinator/captures
# Enables in-tracker capture (disparity + stills) alongside VIO; blank to disable.
# Also the standalone oak-still-capture container's dir. This is the CONTAINER path.
OAK_CAPTURE_DIR=/captures
# #88: image capture (disparity/mono/stills) is gated on FC ARM. coordinator-mavlink writes
# the arm state to this shared file (both containers mount the IPC dir at /tmp) and vio-tracker
# reads it, so bench/idle time doesn't fill the card with pictures of the desk. The .feat
# (IMU+features) is NOT gated -- the FC's EKF starts before arm, so replay needs the pre-arm
# stream. Disarm also triggers a filesystem sync() (durability through the power cut).
OAK_ARM_FILE=/tmp/fc_armed
OAK_JPEG_QUALITY=92
# vio-tracker (VIO-concurrent) capture cadence, #72
OAK_DISPARITY_HZ=1.0
OAK_STILL_HZ=0.2
OAK_STILL_RESOLUTION=12mp
# Still image quality: in flight the ~30 ms auto-exposure (@ ISO 110) smeared every frame. Cap the
# shutter so auto-exposure trades to ISO/gain instead (accept some noise/underexposure for a sharp
# frame); 0 = no cap. OAK_STILL_FOCUS is the IMX378 lens/VCM position with AF off: 255 = macro at
# 8 cm, ~120-130 = infinite focus (varies module to module), below that the lens sits too close to
# the sensor array and goes out of focus (depthai CameraControl.hpp). Mapping subjects are past
# hyperfocal, so infinity. "auto" = leave AF on.
OAK_STILL_MAX_EXPOSURE_US=5000
OAK_STILL_FOCUS=125
# vio-tracker: also capture the rectified-LEFT mono frame -- the exact image the feature tracker
# consumes -- so a feature-starvation (E19) can be explained by what the camera saw (#125). Host samples
# at this rate; 0 disables. One 400p grayscale stream ~= the disparity load already on this USB2 link.
OAK_MONO_HZ=1.0
# Cap the MONO auto-exposure shutter (us) so AE trades to gain instead of a long, blurring exposure in
# low light. Unlike OAK_STILL_MAX_EXPOSURE_US (color/mapping cam), this changes the VIO input itself.
# 0 = no cap (current behaviour). Bench-verify feature tracking before trusting a value in flight.
OAK_MONO_MAX_EXPOSURE_US=0
# standalone oak-still-capture (VIO-off, capture profile) cadence/resolution, #73
OAK_CAPTURE_HZ=0.5
OAK_RESOLUTION=12mp

# Serial device for MAVLink to the flight controller (flight profile only).
# Use the REAL node /dev/ttyAMA0, NOT the /dev/serial0 symlink: Docker's `devices:`
# mapping does not follow symlinks, so /dev/serial0 never appears inside the
# container and the router crash-loops on ENOENT. With disable-bt, ttyAMA0 is the
# PL011 primary UART (= what /dev/serial0 points to). Verified on the bench 2026-07-09.
MAVLINK_DEVICE=/dev/ttyAMA0
MAVLINK_BAUD=1500000

# Compose profile: tracker (OAK-D only), bench (+ estimator), flight (+ mavlink).
# flight is the operational default -- the full online system (tracker -> estimator ->
# mavlink). tracker/bench are bring-up/bench-isolation profiles, not normal ops.
COMPOSE_PROFILES=flight

DEBUG=false
