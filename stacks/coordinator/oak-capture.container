# Colour stills, both monos and the IMU from the OAK. containers/oak-capture/README.md.
[Unit]
Description=OAK capture
PartOf=coordinator-stack.target
# Wall-clock data is the deliverable, so wait for chrony as campod-camera does. The
# target is bounded, and a timeout still reaches it, so this orders capture, never blocks it.
After=time-sync.target
Wants=time-sync.target

[Container]
Image=ghcr.io/symmatree/coordinator-oak-capture:main
ContainerName=oak_capture
Pull=never
PodmanArgs=--privileged --stop-timeout=30

# A VOLUME, not AddDevice: depthai uploads firmware and the OAK re-enumerates at a new
# node under /dev/bus/usb, which a device mapping taken at start cannot see.
# docs/bench-tracker.md has the measurement.
Volume=/dev/bus/usb:/dev/bus/usb
# The arm file coordinator-mavlink writes, and this process's status for pod-link.
Volume=/var/lib/coordinator/ipc:/ipc
Volume=/var/lib/coordinator/captures:/captures
# The host's name and card-image manifest; a container's own hostname is its id.
Volume=/etc/hostname:/etc/host-hostname:ro
Volume=/etc/fleet-image:/etc/fleet-image:ro

# Colour, left and right all at this rate, so each colour frame has a mono pair. Every
# frame is kept. Not 1: the OV9282 monos refuse anything under 1.687 fps (measured
# 2026-10-26, "Desired FPS 1 is lower than min FPS of the sensor config: 1.687").
Environment=OAK_FPS=2
# Colour lens position, 0..255, autofocus off; lower is farther. 115 is the far end of
# Luxonis's fitted lens-position-vs-distance curve for the OAK-D (about 3 m; their
# depth-driven-focus example).
Environment=OAK_LENS_POSITION=115
# Shutter ceiling in us, for all three cameras. A ceiling, not a fixed time: DepthAI has
# no fixed-time, auto-gain mode (src/main.cpp).
Environment=OAK_MAX_EXPOSURE_US=1000
Environment=OAK_JPEG_QUALITY=90
Environment=OAK_IMU_ACCEL_HZ=250
Environment=OAK_WARMUP_FRAMES=10
# Frames that may wait for the writer before one is dropped. The three streams arrive
# together, so each tick takes three slots: 12 is four ticks, 2 s at 2 fps, ~1 MB each.
# At 4, bench-20261027-oak-s2 dropped 5 of 1496 frames, singly.
Environment=OAK_WRITER_QUEUE=12
# Written by coordinator-mavlink: "1" armed, "0" disarmed, absent until it has heard
# the FC. Nothing is written unless it says armed.
Environment=OAK_CAPTURE_FLAG=/ipc/fc_armed
Environment=OAK_STATUS_FILE=/ipc/oak_capture_status

[Service]
TimeoutStopSec=60
# A container that dies mid-run stays dead until the next boot, as the rest of the stack.
Restart=no

[Install]
WantedBy=coordinator-stack.target
