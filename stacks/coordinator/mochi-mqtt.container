# The broker the pods reach the coordinator through. Same implementation the cluster
# runs, so federating this bus upward later is two instances of one thing. Config and
# its differences from the cluster's: mochi-config.yaml.
[Unit]
Description=Coordinator MQTT broker
# NOT PartOf the stack target, and WantedBy multi-user.target rather than it: the
# target is the collection payload and this is the foothold that starts and stops
# it, so a stop of the payload must not take it with it. Why, and the list of paths
# that stop things: docs/pod-bus.md, "The control plane is not the payload".

[Container]
Image=docker.io/mochimqtt/server:2.7
ContainerName=coordinator_mochi_mqtt
Pull=never
Network=host
PodmanArgs=--stop-timeout=10
Volume=/opt/stacks/coordinator/mochi-config.yaml:/config.yaml:ro

[Service]
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=multi-user.target
