# Publishes capture intent to the pods, and reconciles this box's own desired state.
# It reads the arm file the router already writes (#88) rather than speaking MAVLink
# itself, so there is one place that decides what "armed" means and this is downstream
# of it. Contract: docs/pod-bus.md.
[Unit]
Description=Coordinator bus link
PartOf=coordinator-stack.target
After=mochi-mqtt.service

[Container]
Image=ghcr.io/symmatree/coordinator-pod-link:main
ContainerName=coordinator_pod_link
Pull=never
Network=host
# Sibling container inits visible, for stack-level control. See the campod unit.
PodmanArgs=--pid=host --stop-timeout=20

# The arm file lives in the shared ipc dir the router mounts as /tmp.
Volume=/var/lib/coordinator/ipc:/ipc:ro
Volume=/etc/hostname:/etc/host-hostname:ro
Volume=/etc/fleet-image:/etc/fleet-image:ro
# The system bus. Per-unit start and stop go through systemd here, which is the
# granularity this box needs -- `coord fc-log` requires coordinator-mavlink to let go
# of /dev/ttyAMA0, and stopping the whole stack would take the broker down with the
# instruction that asked for it. Also the radio state and an ordered reboot.
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
# Free space where captures land, read-only, for the status document.
Volume=/var/lib/coordinator/captures:/captures:ro

Environment=POD_LINK_ROLE=publisher
Environment=POD_LINK_BROKER=tcp://127.0.0.1:1883
Environment=POD_LINK_ARM_FILE=/ipc/fc_armed
Environment=POD_LINK_PERIOD_S=2
Environment=POD_LINK_DATA_DIR=/captures
# This box has no capture processes of its own writing status documents; the tracker
# and the router write into the session instead. Empty, so the status document carries
# no camera or accel section rather than an error about two files never meant to exist.
Environment=POD_LINK_CAMERA_STATUS_FILE=
Environment=POD_LINK_ACCEL_STATUS_FILE=

[Service]
TimeoutStopSec=40
Restart=no

[Install]
WantedBy=coordinator-stack.target
