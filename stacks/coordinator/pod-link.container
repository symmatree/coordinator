# Publishes capture intent to the pods and reconciles this box's own state. Reads the
# arm file the router writes rather than speaking MAVLink itself. docs/pod-bus.md.
[Unit]
Description=Coordinator bus link
# NOT PartOf the stack target, and WantedBy multi-user.target rather than it: the
# target is the collection payload and this is the foothold that starts and stops
# it, so a stop of the payload must not take it with it. Why, and the list of paths
# that stop things: docs/pod-bus.md, "The control plane is not the payload".
After=mochi-mqtt.service

[Container]
Image=ghcr.io/symmatree/coordinator-pod-link:main
ContainerName=coordinator_pod_link
Pull=never
Network=host
PodmanArgs=--pid=host --stop-timeout=20

Volume=/var/lib/coordinator/ipc:/ipc:ro
Volume=/etc/hostname:/etc/host-hostname:ro
Volume=/etc/fleet-image:/etc/fleet-image:ro
# The system bus: per-unit start/stop, the radio, and reboot.
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
Volume=/var/lib/coordinator/captures:/captures:ro

Environment=POD_LINK_ROLE=publisher
# The collector to stop on a quiesce: the router holds the FC serial and writes the
# session. The coordinator has more slack than a Zero, so this is about releasing the
# port and the capture directory rather than about memory.
Environment=POD_LINK_COLLECTION_UNITS=coordinator-mavlink
Environment=POD_LINK_BROKER=tcp://127.0.0.1:1883
Environment=POD_LINK_ARM_FILE=/ipc/fc_armed
Environment=POD_LINK_PERIOD_S=2
# Matching the campods, so the front panel is as current about this box as about them.
# Nothing here is protecting a camera's residency: this is the 4-core Pi 4B.
Environment=POD_LINK_STATUS_PERIOD_S=5
Environment=POD_LINK_DATA_DIR=/captures
# No capture processes on this box write status files.
Environment=POD_LINK_CAMERA_STATUS_FILE=
Environment=POD_LINK_ACCEL_STATUS_FILE=

[Service]
TimeoutStopSec=40
Restart=no

[Install]
WantedBy=multi-user.target
