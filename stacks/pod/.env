# Pod stack config -- git-authoritative. Do NOT hand-edit the deployed copy on the Pi Zero:
# config lives here in git, and the deploy overwrites the on-box copy (drift trap, #48).
# Change a value here and redeploy. See docs/deployment-model.md. Do not commit secrets here.
HOSTNAME=pod-NNE

# Image tag for the capture container
POD_CAMERA_VERSION=main

# Local capture target (host bind mount; written to the Zero's SD card)
POD_CAPTURES_DIR=/var/lib/pod/captures

# Host path mounted read-only as /config inside containers
POD_CONFIG_DIR=/var/lib/pod/config

# Capture loop (read by containers/pod-camera/capture.py).
# Keep comments on their own lines: env_file passes values verbatim to the
# container, so a trailing "# ..." would become part of the value.
POD_NODE_NAME=pod-NNE
POD_CAPTURE_HZ=1.0
# Width/height 0 = sensor full resolution (IMX708 4608x2592)
POD_CAPTURE_WIDTH=0
POD_CAPTURE_HEIGHT=0
POD_JPEG_QUALITY=90
# Cap the shutter so auto-exposure trades to gain instead of a blurring long
# exposure. 0 = uncapped. The OAK-D side runs OAK_STILL_MAX_EXPOSURE_US=5000 for
# the same reason (T9/E18: AE ran to ~30 ms in flight); matching it keeps the two
# cameras comparable. Blur budget at 5 ms, 66 deg HFOV / 4608 px:
#   hover, 2.5 m   -> GSD 0.71 mm/px, translation blur negligible
#   survey, 25 m, 5 m/s -> GSD 7.05 mm/px, ~3.5 px of along-track smear
# Drop toward 1500 for survey work if the frames come back soft.
POD_STILL_MAX_EXPOSURE_US=5000
# Lens position in DIOPTRES (1/metres): 0.0 = infinity, 0.5 = 2 m, 2.0 = 0.5 m.
# NOT the OAK-D's 0-255 scale -- OAK_STILL_FOCUS=125 would mean 8 mm here.
# `auto` leaves AF running. Default auto on purpose: a wrong fixed position is
# worse than AF, and no bench focus calibration has been run on a CM3 yet.
POD_STILL_FOCUS=auto
# off | server | client -- multi-pod sync is Phase 3 (#24)
POD_SYNC_MODE=off

# --- ADXL345 vibration logging (#211) ---
# Comma list of label:/dev/spidevN.M. EMPTY DISABLES IT -- leave empty until the
# sensors are actually wired, so a missing device is not a boot-time surprise.
# Needs dtparam=spi=on (Imager's SPI toggle, or the pod role once it lands).
# First flight is two: camera-colocated on CE0, arm-end toward the motor on CE1.
#POD_ACCEL_DEVICES=camera:/dev/spidev0.0,arm:/dev/spidev0.1
POD_ACCEL_DEVICES=
# 3200 Hz is the part's native internal rate, so nothing is decimated on the way
# out and the only aliasing is what the MEMS front end physically passes. Lower
# ODRs decimate through a filter the datasheet does not characterise. Lines of
# interest: ~120 Hz motor rev, 290-360 Hz blade-pass, plus harmonics.
POD_ACCEL_ODR_HZ=3200
# +/-16 g. In FULL_RES the scale factor is 3.9 mg/LSB at every range, so the wide
# range costs no resolution and buys headroom at the arm tip. The design doc's
# "tens of microns at ~330 Hz" is 4-9 g, so clipping is a live possibility --
# check the data for rail-hits rather than changing parts pre-emptively.
POD_ACCEL_RANGE_G=16
# At or below 1.6 MHz the datasheet's 5 us FIFO-pop delay is covered by the
# register addressing alone -- no CS-deassert dance. Do not raise this.
POD_ACCEL_SPI_HZ=1500000
# FIFO fills in 10 ms at 3200 Hz, so 200 Hz polling has 2x margin.
POD_ACCEL_POLL_HZ=200
# Camera-to-arm baseline in metres. Differential acceleration over a KNOWN
# separation is the rotational signature -- the number the pair exists to give.
# Measure it as installed and put it here.
POD_ACCEL_SEPARATION_M=

# Compose profile: empty (host bootstrap only), capture (stills), online (Phase 4)
COMPOSE_PROFILES=capture

DEBUG=false
