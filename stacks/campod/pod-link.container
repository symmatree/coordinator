# Carries capture intent from the coordinator and publishes this pod's state.
# docs/pod-bus.md.
[Unit]
Description=campod bus link
# NOT PartOf the stack target, and WantedBy multi-user.target rather than it: the
# target is the collection payload and this is the foothold that starts and stops
# it, so a stop of the payload must not take it with it. Why, and the list of paths
# that stop things: docs/pod-bus.md, "The control plane is not the payload".

[Container]
Image=ghcr.io/symmatree/coordinator-pod-link:main
ContainerName=campod_pod_link
Pull=never
Network=host
# --pid=host: the sibling container inits have to be visible for stack-level control.
PodmanArgs=--pid=host --stop-timeout=20

# tmpfs, so the capture flag and status files never touch the card.
Volume=/tmp:/tmp
Volume=/etc/hostname:/etc/host-hostname:ro
Volume=/etc/fleet-image:/etc/fleet-image:ro
# The system bus: the WiFi radio, reboot, and per-unit start/stop.
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
# Read-only; statfs for free space.
Volume=/var/lib/campod/captures:/captures:ro

Environment=POD_LINK_ROLE=subscriber
# The heavyweight collectors, stopped by a quiesce before anything else runs on this
# box -- see containers/pod-link/quiesce.go. NOT pod-link itself: it is what carries the
# instruction, and a pod that signals its own foothold leaves the bus until someone
# reboots it by hand.
Environment=POD_LINK_COLLECTION_UNITS=campod-camera,campod-accel
# The coordinator's gadget-net address, pinned in host/ansible/vars/gadget-net.yml.
Environment=POD_LINK_BROKER=tcp://10.55.0.1:1883
Environment=POD_LINK_FLAG_FILE=/tmp/campod_capture
Environment=POD_LINK_CAMERA_STATUS_FILE=/tmp/campod_camera_status
Environment=POD_LINK_ACCEL_STATUS_FILE=/tmp/campod_accel_status
Environment=POD_LINK_DATA_DIR=/captures
# Seconds between reconciles, which is also how far behind the device a reader can be.
# 60 was chosen to protect the camera's page residency, on a figure -- "136 ms against
# 22 s" -- that measured `docker ps`: a fork and a 71 MiB CLI faulting in off a contended
# card. A tick here is a resident ~8 MB Go process reading /proc/uptime, two tmpfs files,
# one statfs and one D-Bus property, and nobody has ever measured it costing anything.
# self_major_faults in the published document is what would show it if it did.
Environment=POD_LINK_STATUS_PERIOD_S=5

[Service]
TimeoutStopSec=40
Restart=no

[Install]
WantedBy=multi-user.target
