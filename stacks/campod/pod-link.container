# Carries capture intent from the coordinator and publishes this pod's state.
# docs/pod-bus.md.
[Unit]
Description=campod bus link
PartOf=campod-stack.target

[Container]
Image=ghcr.io/symmatree/coordinator-pod-link:main
ContainerName=campod_pod_link
Pull=never
Network=host
# --pid=host: the sibling container inits have to be visible for stack-level control.
PodmanArgs=--pid=host --stop-timeout=20

# tmpfs, so the capture flag and status files never touch the card.
Volume=/tmp:/tmp
Volume=/etc/hostname:/etc/host-hostname:ro
Volume=/etc/fleet-image:/etc/fleet-image:ro
# The system bus: the WiFi radio, reboot, and per-unit start/stop.
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
# Read-only; statfs for free space.
Volume=/var/lib/campod/captures:/captures:ro

Environment=POD_LINK_ROLE=subscriber
# The coordinator's gadget-net address, pinned in host/ansible/vars/gadget-net.yml.
Environment=POD_LINK_BROKER=tcp://10.55.0.1:1883
Environment=POD_LINK_FLAG_FILE=/tmp/campod_capture
Environment=POD_LINK_CAMERA_STATUS_FILE=/tmp/campod_camera_status
Environment=POD_LINK_ACCEL_STATUS_FILE=/tmp/campod_accel_status
Environment=POD_LINK_DATA_DIR=/captures
# Seconds between reconciles. Raised on demand via desired/status_period.
Environment=POD_LINK_STATUS_PERIOD_S=60

[Service]
TimeoutStopSec=40
Restart=no

[Install]
WantedBy=campod-stack.target
