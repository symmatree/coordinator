# Still capture from the Camera Module 3 (IMX708). docs/campod.md.
[Unit]
Description=campod still capture
PartOf=campod-stack.target
# Wall-clock data is the deliverable, so wait for chrony to set the clock rather than
# stamping the first ~74 s of a boot from the image's build epoch. time-sync.target is
# reached by chrony's own chrony-wait.service, which roles/chrony enables; it is bounded
# at 180 s and a timeout still activates the target, so this orders capture later and
# never prevents it. Why it matters to camera sync: roles/chrony/tasks/main.yml.
After=time-sync.target
Wants=time-sync.target

[Container]
Image=ghcr.io/symmatree/coordinator-campod-camera:main
ContainerName=campod_camera
# The C++ capture. capture.py, the picamera2 original, is still in the image with the same
# environment: `Exec=python3 /opt/campod/capture.py` runs it instead.
Exec=/opt/campod/campod-capture
# A power-up must need no network: docs/deployment-model.md.
Pull=never

# HOST NETWORK NAMESPACE, because the camera-sync algorithm is a network protocol.
# libcamera's sync server multicasts to 239.255.255.250 and the client joins that
# group; in podman's default bridge namespace both happen on a veth that the other
# pod cannot reach, and usb0 -- the only path between pods -- does not exist there
# at all.
#
# MEASURED 2026-10-15: with the camera in its own namespace, `ip maddr show` on both
# campods showed the group joined on NO host interface, and the client reported
# SyncTimer None for two consecutive runs while capturing and discarding every frame.
# The server appeared to work only because a sync server never has to receive
# anything.
#
# Needs the gadget route in roles/campod-hardware to be useful: that decides WHICH
# host interface the group resolves to, and this decides whether the camera can see
# host interfaces at all. Neither alone is enough.
Network=host

# privileged: libcamera/IMX708 and /dev/spidev* for the accelerometer reader. Needs
# dtparam=spi=on on the host for the spidev nodes to exist.
PodmanArgs=--privileged --stop-timeout=90

# libcamera enumerates the camera through udev.
Volume=/run/udev:/run/udev:ro
Volume=/var/lib/campod/captures:/captures
Volume=/var/lib/campod/config:/config:ro
# The host's name and card-image manifest; a container's own hostname is its id.
Volume=/etc/hostname:/etc/host-hostname:ro
Volume=/etc/fleet-image:/etc/fleet-image:ro
# Shared with pod-link and the accel reader: the capture flag and the status files.
Volume=/tmp:/tmp

# No capture rate: the rate is the pinned frame duration below.
# 0 = sensor full resolution, 4608x2592, which also selects the sensor mode. The C++
# capture's output buffers are YUV420, 17.9 MB each at this size, where capture.py's main
# stream was 35.8 MB of RGB.
Environment=CAMPOD_CAPTURE_WIDTH=0
Environment=CAMPOD_CAPTURE_HEIGHT=0
Environment=CAMPOD_JPEG_QUALITY=90
# Shutter cap in us; auto-exposure trades the rest to gain. 0 = uncapped.
Environment=CAMPOD_STILL_MAX_EXPOSURE_US=1000
# Lens position in dioptres, 1/metres. Mapping subjects are at infinity.
Environment=CAMPOD_STILL_FOCUS=infinity
# off | server | client. Multi-campod sync is #24.
# libcamera software sync: one pod paces, the rest follow. ON, with campod-sw named as
# the pacesetter -- it is the pod with the accelerometers, so its frames are the ones worth
# having a hard reference for.
#
# ONE VALUE FOR EVERY POD, which is all this file can express: it is copied identically to
# each pod and a converge passes only device_role, so there is no per-pod env to hold
# "server". Each pod compares this against its own /etc/hostname. Electing the leader over
# the bus instead is coordinator#501.
# Fixed frame duration, which the camera-sync algorithm requires -- without it libcamera
# logs an error every frame and its single-frame correction has nothing stable to correct
# against. Clamped to what the mode allows; the capture logs what it achieved.
#
# 1 Hz at full resolution, AND THIS IS NOW THE CAPTURE RATE. The capture keeps every frame
# it is handed, so the pin is the only control over how much is written: there is no
# selection rule to thin a faster grid any more. Raising this raises the card load in
# proportion.
#
# Why one: with two camera buffers the IPA ticks once per sensor frame, so we see every
# frame and do not need a rule to pick from them -- and a frame lost at 1 Hz is an absent
# frame rather than a pair 500 ms apart, which is what every remaining outlier at the 2 Hz
# pin turned out to be. The sensor mode's floor is 69669 us, so faster is legal; a Zero
# running its sensor fast for a 1 Hz stills job is heat for nothing.
Environment=CAMPOD_FRAME_DURATION_US=1000000
# libcamera runs the IPA, and so the sync algorithm, once per queued application request --
# so this sets how many sensor frames one sync correction is applied across. At one, that
# was 2 to 4 frames and the client never converged.
Environment=CAMPOD_BUFFER_COUNT=2
Environment=CAMPOD_SYNC_LEADER=campod-sw
# WHAT THE SYNC ALGORITHM COMPUTES, which is the one thing the data cannot show.
#
# Measured on 2026-10-16: both pods report sync_ready true on every frame and their
# exposures sit 99.6 ms apart -- half a frame period -- drifting independently rather than
# converging. SyncReady turns out to be a frame COUNTDOWN (`syncReady_` is set when the
# frame count reaches readyFrame_, sync.cpp), so it never claimed alignment, and the
# per-frame SyncTimer in the sidecar says how far off we are but not why.
#
# At Debug, sync.cpp prints serverFrameTimestamp, clientFrameTimestamp,
# clientFrameTimestampNearest and the computed `correction` for every packet received, and
# the server prints what it sends. That distinguishes the three live possibilities:
# corrections not computed, computed but below minAdjustment (50 us, which 99.6 ms is not),
# or computed and not taking effect at the sensor.
#
# Cheap: the client logs only on a received packet and the server only when it sends, which
# is once per sync_period -- 30 frames, about 6 s. Not a per-frame firehose.
#
# Scoped to RPiSync rather than a global level, so the journal does not fill with pipeline
# and IPA chatter on a box whose card is the thing being protected.
Environment=LIBCAMERA_LOG_LEVELS=RPiSync:DEBUG
# Capture is paused until something writes this file (#434, docs/pod-bus.md). Empty
# disables gating and captures continuously.
Environment=CAMPOD_CAPTURE_FLAG=/tmp/campod_capture
Environment=CAMPOD_WARMUP_FRAMES=10
Environment=CAMPOD_STATUS_FILE=/tmp/campod_camera_status

[Service]
# systemd must outlast --stop-timeout above. The only measured graceful exit was 35 s.
TimeoutStopSec=120
# A container that dies mid-run stays dead until the next boot.
Restart=no

[Install]
WantedBy=campod-stack.target
