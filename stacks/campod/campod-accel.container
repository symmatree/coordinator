# Both ADXL345s into JSONL. Same image as the camera; they agree on an output path via
# the kernel boot_id. containers/campod-camera/README.md.
[Unit]
Description=campod accelerometer capture
PartOf=campod-stack.target

[Container]
Image=ghcr.io/symmatree/coordinator-campod-camera:main
ContainerName=campod_accel
Exec=/opt/campod/campod-accel
Pull=never
# privileged: /dev/spidev0.0 and 0.1. Needs dtparam=spi=on on the host.
PodmanArgs=--privileged --stop-timeout=90

Volume=/var/lib/campod/captures:/captures
# Shared: this writes its status file here for pod-link.
Volume=/tmp:/tmp
Volume=/etc/hostname:/etc/host-hostname:ro
Volume=/etc/fleet-image:/etc/fleet-image:ro

# Camera-to-arm-end baseline in metres, measured per vehicle. The differential
# acceleration is meaningless without it. Empty until measured on the airframe.
Environment=CAMPOD_ACCEL_SEPARATION_M=
Environment=CAMPOD_ACCEL_SYNC_KIB=0
Environment=CAMPOD_ACCEL_STATUS_FILE=/tmp/campod_accel_status

[Service]
TimeoutStopSec=120
Restart=no

[Install]
WantedBy=campod-stack.target
