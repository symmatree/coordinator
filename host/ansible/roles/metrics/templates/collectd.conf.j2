# Managed by ansible (roles/metrics). Local changes will be overwritten.
#
# System metrics for post-flight forensics. Deliberately small: the four families
# worth the write volume on an SD card in a vehicle, and nothing else. Adding a
# plugin is cheap to type and not cheap to carry -- every one is more cardinality,
# more lines per interval, and more card wear, forever.

# No DNS at startup. The vehicle drops wifi in flight by design and the gadget net
# has no resolver, so an FQDN lookup here is a hang waiting to happen for a value
# we do not use -- the CSV tree is keyed by hostname either way.
FQDNLookup false
Interval {{ metrics_interval }}

LoadPlugin cpu
LoadPlugin memory
LoadPlugin vmem
LoadPlugin processes
LoadPlugin disk
LoadPlugin thermal
LoadPlugin interface
LoadPlugin csv

<Plugin interface>
  # Added because a question we could not answer: a converge that should take
  # minutes took over an hour, and "was the wifi worse that time?" had no data
  # behind it. wlan0 measured -64 dBm with 239 retry-discarded packets on the
  # bench next to the AP, which is the best case a pod will ever see -- so link
  # quality is a real variable in converge duration and we were not recording it.
  #
  # Named explicitly rather than collecting everything: docker creates a veth per
  # container and a bridge per network, so IgnoreSelected false would grow the CSV
  # tree with interfaces that come and go and tell us nothing.
  Interface "wlan0"
  Interface "usb0"
  IgnoreSelected false
</Plugin>

<Plugin cpu>
  # Per-core and per-state. On a 4-core Zero 2 W that is the difference between
  # "busy" and "one core pinned in iowait while three idle", which is the actual
  # question when capture stutters.
  ReportByCpu true
  ReportByState true
  # Raw jiffy counters, not percentages -- see StoreRates below.
  ValuesPercentage false
</Plugin>

<Plugin memory>
  # Absolute bytes per category (used/buffered/cached/free/slab). "Ideally a few
  # categories" is the whole point on a 512 MB Zero: total-used cannot tell you
  # whether you are about to OOM or just have a warm page cache.
  ValuesAbsolute true
  ValuesPercentage false
</Plugin>

<Plugin vmem>
  # Why: the campod's measured failure mode is read volume on a saturated card,
  # and the memory plugin cannot say whether a read was a page fault or a file
  # read. pgmajfault is the counter that separates them.
  #
  # Verbose true, which is what gets the nr_* fields -- nr_dirty and nr_writeback
  # are the writeback picture, and whether Dirty is flat with Writeback at zero is
  # the difference between "writes are keeping up" and "writes are queued behind
  # reads". The plugin dispatches 51 nr_* fields on this kernel; that is the whole
  # cost of this option and it is text in a CSV, not a sample per interval per
  # field in a time-series database.
  Verbose true
</Plugin>

<Plugin processes>
  # Whole-disk counters cannot attribute I/O to a process, which is the question
  # every episode so far has turned on. This gives per-process RSS plus minor and
  # major fault counts, so "who is thrashing" is answerable from the record rather
  # than needing somebody logged in during the window sampling /proc by hand --
  # which is itself load on the box being measured.
  #
  # ProcessMatch, not Process: `Process` matches comm, which the kernel truncates
  # to 15 characters and which for a Python program is "python3". ProcessMatch
  # matches the command line -- /proc/<pid>/cmdline with its NULs turned into
  # spaces (processes.c ps_get_cmdline), so these patterns are written against the
  # space-joined form. They are POSIX regexes and unanchored.
  #
  # collectd runs on the host in the host PID namespace, so container processes
  # appear here with their host PIDs; nothing has to reach into a container.
  ProcessMatch "capture" "python3 /opt/campod/capture.py"
  ProcessMatch "accel" "/opt/campod/campod-accel"
  # The ~56 MiB resident jump at storm onset has never been attributed, and these
  # are the candidates big enough to be it. "containerd" also matches the
  # per-container shims, so read that row as the container runtime in total rather
  # than as the daemon alone.
  ProcessMatch "dockerd" "/usr/bin/dockerd"
  ProcessMatch "containerd" "/usr/bin/containerd"
  # The instrument's own cost, because on this board observation IS load and a
  # measurement that cannot state its own footprint is asking to be trusted.
  ProcessMatch "collectd" "/usr/sbin/collectd"

  # COST, stated rather than buried: this plugin stats every entry in /proc every
  # interval -- it has to, in order to classify them -- so it is a procfs walk of
  # every process at {{ metrics_interval }}s, whatever the match list says. In-kernel
  # reads, no card I/O, but not free on a four-core Zero.
  #
  # CollectMemoryMaps is the one option whose cost scales with the address space
  # rather than being fixed: it reads /proc/<pid>/smaps, walking every VMA, every
  # interval, on the box whose paging is the thing under measurement. Off.
  CollectMemoryMaps false
  # Cheap, and a process switching hard while making no progress looks different
  # from one that is simply blocked.
  CollectContextSwitch true
  CollectFileDescriptor false
</Plugin>

<Plugin disk>
  # Whole disks only, not partitions. Per-partition rows would triple the
  # cardinality and answer nothing.
  #
  # This comment used to claim the plugin also records pending_operations as an
  # io-queue-depth signal. It does not: an archived tree from a real device
  # carries disk_io_time, disk_merged, disk_octets, disk_ops and disk_time and
  # nothing else. The utilization signal we actually have is disk_io_time, whose
  # io_time field is milliseconds during which the device had I/O in flight --
  # so a 10 s interval advancing it by 10000 is a device that was busy
  # throughout. Read saturation off that, not off a byte rate against a guessed
  # ceiling.
  Disk "/^mmcblk[0-9]+$/"
  Disk "/^nvme[0-9]+n[0-9]+$/"
  IgnoreSelected false
</Plugin>

<Plugin thermal>
  # All thermal zones; on a Pi that is the SoC sensor.
  # NOTE: this is temperature only. Whether the SoC was actually throttled or
  # under-volted is a Pi-specific bit vector from `vcgencmd get_throttled`, which
  # no collectd plugin reads -- coordinator-throttle.timer already logs that to the
  # journal every 30s. The two are complementary: this says how hot, that says
  # whether it cost us anything.
</Plugin>

<Plugin csv>
  # A symlink to /var/log/collectd/<this boot's id>, made by
  # collectd-per-boot-datadir before the service starts (roles/metrics). A SESSION IS
  # A BOOT, so keying the tree by boot id makes a session's samples an exact
  # selection -- copy one directory -- instead of a row filter on a wall clock that is
  # wrong from boot until NTP lands, and never corrected at all in the field.
  #
  # Via /run rather than a symlink inside the tree: /run is tmpfs, so a stale link
  # cannot outlive the boot it names, and the retention cleanup never sees it.
  DataDir "/run/collectd-datadir"
  # Raw counters, not rates. Counters are lossless: a gap across a power cut is
  # visible and the rate is still derivable afterwards. Pre-computed rates throw
  # that away, and the analysis side is where the arithmetic belongs anyway.
  StoreRates false
</Plugin>
