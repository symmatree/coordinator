[Unit]
Description=Enable the DS3234 1 Hz square wave for PPS (coordinator#11)
Documentation=https://github.com/symmatree/coordinator/issues/11

# pps_gpio and spidev are modules in this image, so neither device exists until udev has
# coldplugged. Naming the spidev makes the open deterministic rather than a race.
Wants=dev-spidev0.0.device
After=dev-spidev0.0.device

[Service]
Type=oneshot
# Writes the CONTROL register (0x0E) only. The time registers are never written here --
# that resets the countdown chain and re-phases the 1 Hz, which the campods' blanking
# alignment depends on not happening.
ExecStart=/usr/local/bin/coord-rtc enable-pps
# The write is to a register, not to a file, so there is nothing to keep alive -- but the
# unit staying active is how `systemctl status` answers "did the PPS line get configured
# this boot" without talking to the chip again.
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
