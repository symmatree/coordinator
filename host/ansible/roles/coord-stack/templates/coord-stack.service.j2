[Unit]
# Auto-start this device's stack on every boot, so it returns to a known-good
# running state regardless of the last operator command (#97).
#
# This unit is the ONLY thing that starts the stack. No service in either stack
# carries a `restart:` policy, so dockerd starts nothing on its own and nothing
# races this. `coord start` is `compose up -d`, which starts stopped containers, so
# a power yank, a `shutdown -h now`, and a `coord stop` followed by a power cycle
# all come back up running -- which is #97's point: a known-good running state
# regardless of the last operator command. A pod stopped for bench work and then
# carried out and connected to a battery has nobody there to start it.
#
# A container that dies mid-run therefore stays dead until the next boot, and that
# is wanted. None of these come up happy mid-flight, and feeding the FC data from a
# container that just restarted would be suspect. A restart policy also fights this
# unit: it brought containers back DURING a shutdown on campod-se, where the
# accelerometer reader exited cleanly on the reboot's SIGTERM and dockerd started a
# fresh session 22 s later on a box that was going down.
#
# Shared by both roles because the coordinator had it and the campod did not,
# which was an accident of where the task lived rather than a decision.
#
# To deliberately keep the stack down across a reboot, disable THIS unit
# (`systemctl disable --now {{ coord_stack_name }}-stack.service`), not `coord stop`.
Description=Rekon {{ coord_stack_name }} stack (auto-start on boot)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Retry in case the Docker socket is not ready the instant docker.service is up.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
# Idempotent: `coord start` = `docker compose up -d --pull never`, which brings up
# everything in the stack file using only images already on disk. It will NOT fetch
# -- a power-up must need no network (deployment-model.md), and this unit runs
# unattended on a vehicle that may have none. Convergence ends with a pull, so a
# converged node has its images and a missing one means something is wrong rather
# than merely absent -- the unit then fails in seconds with a missing-image error
# instead of stalling on a fetch nobody is watching.
#
# No profile and no .env are involved -- neither stack carries compose profiles any
# more (#240, #242). `coord` resolves the sole stack under /opt/stacks itself, so
# this line needs no per-device argument.
ExecStart=/usr/local/bin/coord start
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
