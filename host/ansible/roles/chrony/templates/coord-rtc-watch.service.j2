[Unit]
Description=Publish the 1 Hz and chrony's lock to it for pod-link (campod)
Documentation=https://github.com/symmatree/coordinator/blob/main/docs/pod-bus.md
# The campod's half of coord-rtc-feed: the same tool and the same status document, with
# no chip -- so no SPI, which on a campod is the accelerometers -- and nothing to send
# chrony. Asks chronyc each look, so it starts after chronyd; until chronyd answers the
# document says pps_selected: null.
After=chronyd.service
Wants=dev-pps0.device
After=dev-pps0.device

[Service]
# tmpfs, beside the camera and accel documents pod-link already reads from /tmp.
Environment=COORD_RTC_STATUS_FILE={{ coord_rtc_campod_status_file }}
ExecStart=/usr/local/bin/coord-rtc watch
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
