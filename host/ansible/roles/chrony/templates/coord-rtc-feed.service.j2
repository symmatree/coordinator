[Unit]
Description=Serve the DS3234 to chrony as a SOCK refclock (coordinator#11)
Documentation=https://github.com/symmatree/coordinator/issues/11
# chrony creates the socket, so this has nothing to wait for -- it retries, and says
# so, until the socket appears.
After=chronyd.service
Wants=chronyd.service
# spidev and pps_gpio are both modules, so these appear only after udev coldplug. The
# feed needs both now: the chip over SPI for the label, and the pulse for the instant it
# belongs to. Wants rather than Requires on the PPS device -- without an edge the feed
# falls back to chasing the seconds register and says so, which is worth having on a
# coordinator whose leg is not soldered.
Wants=dev-spidev0.0.device
After=dev-spidev0.0.device
Wants=dev-pps0.device
After=dev-pps0.device

[Service]
# One definition of the socket path, shared with the drop-in that tells chrony to
# listen on it.
Environment=COORD_RTC_CHRONY_SOCK={{ coord_rtc_chrony_sock }}
# Not oneshot: chrony ages a source out if samples stop arriving, so this runs for as
# long as chrony does.
ExecStart=/usr/local/bin/coord-rtc feed
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
