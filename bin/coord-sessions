#!/usr/bin/env python3
"""List capture sessions on this device, and package one into a verified bundle (#302).

Device-side half of post-flight recovery. Two operations, no service and no state:
`list` says what is here, `package` turns one session into a single file plus a
manifest that describes it. Who moves the bytes afterwards is a transport question
and is not here.

A SESSION IS A BOOT, and CAPTURE IS ASSUMED STOPPED for all three verbs -- both are
properties of every script in here rather than of this one, so they live in
bin/README.md. The short of it: a session directory is a kernel boot id, only a
reboot ends one, and nothing here checks that capture has stopped.

Output is JSON, not the TOML that bin/coord-version emits. That format exists so a
manifest can be sourced by a shell and read by systemd; this is nested data with
lists in it, and has no such caller.
"""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import shutil
import socket
import subprocess
import sys
import tarfile
import time
from pathlib import Path

STACKS_ROOT = Path("/opt/stacks")
BOOT_ID = Path("/proc/sys/kernel/random/boot_id")

# zstd rather than gzip: faster at a better ratio, and it recognises incompressible
# input rather than grinding on it -- which matters here because JPEG is the larger
# half of a session and will not shrink at any level. The accelerometer jsonl is the
# half that does compress. Level 3 is zstd's default and is already well past gzip;
# -T0 uses the Zero's four cores, which are idle by the time this runs.
#
# The CLI, not a library: trixie ships Python 3.13 and stdlib zstd landed in 3.14.
# roles/coord-stack installs the package.
ZSTD_LEVEL = 3

# Headroom over the session's own size. The bundle lands on the same filesystem as
# the thing it contains, so packaging needs room for both at once (#223: ~1.3 GB per
# pod per flight). 5% covers the tar headers and the compressed jsonl being
# non-zero; it does not pretend to know the compression ratio.
FREE_MARGIN = 1.05


def boot_id() -> str:
    try:
        return BOOT_ID.read_text().strip()
    except OSError:
        return ""


def state_root() -> Path | None:
    """/var/lib/<stack> for the sole installed stack, or None if that is ambiguous."""
    stacks = sorted(p.name for p in STACKS_ROOT.glob("*")) if STACKS_ROOT.is_dir() else []
    return Path("/var/lib") / stacks[0] if len(stacks) == 1 else None


def resolve(captures: Path, session: str) -> tuple[str, Path] | None:
    """(node, dir) for a session id, or None. Raises on an id that is not one.

    The id is a single directory name and is checked to be one. This command
    exists partly so that nobody assembles an rm -rf path on the other end of an
    ssh connection; accepting a separator here would hand that back.
    """
    if not session or "/" in session or session in (".", ".."):
        raise ValueError(f"{session!r} is not a session id")
    # Anchored on this node for the same reason find_sessions is: delete must not be able
    # to reach a subtree that is not ours, such as the coordinator's OAK-D capture tree.
    node_dir = captures / node_name()
    return (node_dir.name, node_dir / session) if (node_dir / session).is_dir() else None


def bundle_path(out_dir: Path, node: str, session: str) -> Path:
    return out_dir / f"{node}_{session}.tar.zst"


def sidecar_utc(path: Path) -> str | None:
    try:
        return json.loads(path.read_text()).get("wall_clock_utc")
    except (OSError, json.JSONDecodeError, AttributeError):
        return None


def describe(session_dir: Path, node: str, current_boot: str) -> dict:
    """One session. Frame count, bytes and span, because the name carries no clock.

    The directory is a boot id, so there is nothing in it to sort or judge by. What
    tells a 25-minute flight from a failed-lock power cycle is ~1500 frames against
    tens, the total size, and the span between the first and last sidecar -- and the
    sidecar clock is the device's, with no PPS wired (#11).
    """
    files = [p for p in session_dir.rglob("*") if p.is_file()]
    sidecars = sorted(p for p in files if p.suffix == ".json" and p.parent == session_dir)
    first = sidecar_utc(sidecars[0]) if sidecars else None
    last = sidecar_utc(sidecars[-1]) if sidecars else None
    return {
        "node": node,
        "session": session_dir.name,
        "path": str(session_dir),
        # This boot's directory, which `coord start` would append to. NOT "something
        # is writing": with capture stopped it is as finished as any other, and
        # package treats it that way.
        "open": session_dir.name == current_boot,
        "bytes": sum(p.stat().st_size for p in files),
        "files": len(files),
        "frames": sum(1 for p in files if p.suffix == ".jpg"),
        "accel": sorted(p.name for p in files if p.name.startswith("accel-")),
        "manifests": sorted(p.name for p in (session_dir / "manifests").glob("*")),
        "first_utc": first,
        "last_utc": last,
    }


def node_name() -> str:
    """This machine. capture.py writes to <captures>/<node>/<session>/ using the host's
    own name, so that is the only subtree here that holds sessions of ours."""
    return socket.gethostname()


def find_sessions(captures: Path, current_boot: str) -> list[dict]:
    """Sessions belonging to THIS node, and nothing else under captures/.

    It used to walk every child of captures/ as if it were a node. That is campod's
    layout, not a rule. The coordinator shares one captures/ between three services:
    vio-tracker writes OAK-D captures under a directory named for the camera's DepthAI
    MxId, and coordinator-mavlink drops timesync.jsonl and vehicle.tlog beside them. So
    the walk reported `18443010B1D8BC0800` -- a camera serial -- as a node, the UI grouped
    by it and POSTed to /nodes/18443010B1D8BC0800/sessions/delete, and got `no such node`.

    Anchoring on the hostname means the coordinator reports nothing rather than garbage,
    which is honest: it has no campod-style sessions. If OAK-D captures should be
    offloadable they need their own shape, not this one guessing at theirs.
    """
    node_dir = captures / node_name()
    if not node_dir.is_dir():
        return []
    return [
        describe(session_dir, node_dir.name, current_boot)
        for session_dir in sorted(p for p in node_dir.glob("*") if p.is_dir())
    ]


def cmd_list(captures: Path) -> int:
    current = boot_id()
    print(json.dumps({
        "captures_root": str(captures),
        "boot_id": current,
        "sessions": find_sessions(captures, current),
    }, indent=2))
    return 0


def add_hashed(tar: tarfile.TarFile, path: Path, arcname: str) -> str:
    """Add one file and return its sha256, reading it through a single open handle."""
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
        fh.seek(0)
        info = tar.gettarinfo(str(path), arcname=arcname)
        tar.addfile(info, fh)
    return h.hexdigest()


def cmd_package(captures: Path, session: str, out_dir: Path) -> int:
    current = boot_id()
    try:
        found = resolve(captures, session)
    except ValueError as exc:
        print(f"coord-sessions: {exc}", file=sys.stderr)
        return 1
    if found is None:
        print(f"coord-sessions: no session {session} under {captures}", file=sys.stderr)
        return 1
    node, session_dir = found

    files = sorted(p for p in session_dir.rglob("*") if p.is_file())
    if not files:
        print(f"coord-sessions: {session} is empty", file=sys.stderr)
        return 1
    raw = sum(p.stat().st_size for p in files)

    out_dir.mkdir(parents=True, exist_ok=True)
    st = os.statvfs(out_dir)
    free = st.f_bavail * st.f_frsize
    need = int(raw * FREE_MARGIN)
    if free < need:
        print(
            f"coord-sessions: {need} bytes needed to package {session} beside itself, "
            f"{free} free on {out_dir}",
            file=sys.stderr,
        )
        return 1

    bundle = bundle_path(out_dir, node, session)
    partial = bundle.with_suffix(".partial")
    started = time.time()
    proc = None
    try:
        entries = {}
        # Stream the tar straight into zstd rather than building it first: one pass,
        # and the uncompressed archive never exists on a card that has room for it
        # only just.
        proc = subprocess.Popen(
            ["zstd", "-q", f"-{ZSTD_LEVEL}", "-T0", "-o", str(partial)],
            stdin=subprocess.PIPE,
        )
        with tarfile.open(fileobj=proc.stdin, mode="w|") as tar:
            for path in files:
                rel = path.relative_to(session_dir)
                entries[str(rel)] = {
                    "bytes": path.stat().st_size,
                    "sha256": add_hashed(tar, path, f"{node}/{session}/{rel}"),
                }
            # Inside the bundle, so an extracted directory can be checked on its own
            # without the file that carried it.
            manifest = {
                "schema": 1,
                "node": node,
                "session": session,
                "packaged_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "packaged_by_boot": current,
                "source_bytes": raw,
                "files": entries,
            }
            blob = json.dumps(manifest, indent=2, sort_keys=True).encode()
            info = tarfile.TarInfo(f"{node}/{session}/manifest.json")
            info.size = len(blob)
            info.mtime = int(started)
            tar.addfile(info, io.BytesIO(blob))
        proc.stdin.close()
        if proc.wait() != 0:
            raise RuntimeError(f"zstd exited {proc.returncode}")
        partial.replace(bundle)
    except Exception as exc:  # noqa: BLE001  any failure must not leave a partial bundle
        if proc is not None and proc.poll() is None:
            proc.kill()
            proc.wait()
        partial.unlink(missing_ok=True)
        print(f"coord-sessions: packaging {session} failed: {exc}", file=sys.stderr)
        return 1

    h = hashlib.sha256()
    with bundle.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    # Small enough to read without extracting anything: what to fetch, what it should
    # hash to, and what it came from. The per-file hashes are inside.
    print(json.dumps({
        "node": node,
        "session": session,
        "bundle": str(bundle),
        "bytes": bundle.stat().st_size,
        "sha256": h.hexdigest(),
        "source_bytes": raw,
        "files": len(entries),
        "seconds": round(time.time() - started, 1),
    }, indent=2))
    return 0


def cmd_delete(captures: Path, sessions: list[str], out_dir: Path) -> int:
    """Remove sessions and their bundles. Takes a list; both callers are one verb.

    The transfer deletes each session as it verifies it, and the operator prunes
    whatever was not selected in one go (#302, #31). Same operation either way.

    The current boot's session is not special here, any more than it is in package.
    Refusing it would make it the one directory that cannot be pruned without a
    reboot, which is the disk filling up -- the reason this verb exists.

    Absent is not an error. The wanted end state is that it is gone, and a transfer
    loop retrying a delete should not fail; the result says `absent` so a caller can
    still tell the difference from `deleted`.
    """
    results, failed = [], False
    for session in sessions:
        try:
            found = resolve(captures, session)
        except ValueError as exc:
            print(f"coord-sessions: {exc}", file=sys.stderr)
            failed = True
            continue

        entry = {"session": session, "session_dir": "absent", "bundle": "absent", "bytes": 0}
        if found is not None:
            node, session_dir = found
            entry["node"] = node
            freed = sum(p.stat().st_size for p in session_dir.rglob("*") if p.is_file())
            try:
                shutil.rmtree(session_dir)
            except OSError as exc:
                print(f"coord-sessions: cannot remove {session_dir}: {exc}", file=sys.stderr)
                failed = True
                continue
            entry["session_dir"], entry["bytes"] = str(session_dir), freed

            # The bundle is the same data again, so leaving it frees half the space
            # the caller asked for and leaves a second copy nobody owns.
            bundle = bundle_path(out_dir, node, session)
            if bundle.is_file():
                entry["bytes"] += bundle.stat().st_size
                try:
                    bundle.unlink()
                    entry["bundle"] = str(bundle)
                except OSError as exc:
                    print(f"coord-sessions: cannot remove {bundle}: {exc}", file=sys.stderr)
                    failed = True
        results.append(entry)

    print(json.dumps({
        "deleted": results,
        "bytes": sum(r["bytes"] for r in results),
    }, indent=2))
    return 1 if failed else 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--captures-root", type=Path, help="default: <state root>/captures")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="every session on this device, as JSON")
    pkg = sub.add_parser("package", help="one closed session into a verified bundle")
    pkg.add_argument("session")
    pkg.add_argument("--out-dir", type=Path, help="default: <state root>/bundles")
    rm = sub.add_parser("delete", help="remove sessions and their bundles")
    rm.add_argument("session", nargs="+")
    rm.add_argument("--out-dir", type=Path, help="default: <state root>/bundles")
    args = ap.parse_args(argv)

    root = state_root()
    captures = args.captures_root or (root / "captures" if root else None)
    if captures is None:
        print(
            "coord-sessions: cannot tell which stack's captures to read; "
            "pass --captures-root",
            file=sys.stderr,
        )
        return 2
    if not captures.is_dir():
        print(f"coord-sessions: no captures directory at {captures}", file=sys.stderr)
        return 2

    if args.cmd == "list":
        return cmd_list(captures)
    out_dir = args.out_dir or (root / "bundles" if root else captures.parent / "bundles")
    if args.cmd == "delete":
        return cmd_delete(captures, args.session, out_dir)
    return cmd_package(captures, args.session, out_dir)


if __name__ == "__main__":
    sys.exit(main())
