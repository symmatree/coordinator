#!/usr/bin/env python3
"""List and pull the flight controller's dataflash logs, over the link we already have.

The coordinator is wired to the FC on /dev/ttyAMA0 and is the only thing that is. So the
.bin comes off the FC through here -- no second device on the FC, no pulling its card
(#77). Proven on 2026-09-23: 154,894,336 bytes with zero missing ranges, verified against
an independent ground-side observer.

    coord fc-log list
    coord fc-log pull <id>              # the log goes to STDOUT, not to a file here

Nothing lands on the device. `pull` streams to stdout so the caller's shell writes the
file where it belongs:

    ssh pi@coordinator 'sudo coord fc-log pull 3' > fc-log-3.bin

THE PORT MUST BE FREE. coordinator-mavlink holds /dev/ttyAMA0 while the stack is up, and
two readers on one UART get half a byte stream each. Quiesce first -- which is what
fleet-control's probe/offload already do, so in the post-flight flow the port is free by
the time you get here.

WHY THIS RUNS IN A CONTAINER. pymavlink is not installed on the host and should not be:
the host is ansible-managed and this is the only thing that would want it. The
coordinator-mavlink image already carries it (pinned 2.4.49), so when the import fails we
re-exec ourselves inside that image with the device passed through. One implementation,
runnable either way.

WHICH LOG IS THE FLIGHT -- the ground picks, this only reports. `list` prints what the FC
has; the caller matches it against the armed window, which it knows from the ground-side
mavproxy console without needing anything from the vehicle. The rule, for a human reading
the list: LOG_ENTRY.time_utc is LAST-MODIFIED, NOT CREATION -- with LOG_FILE_DSRMROT=1 the
flight log is the one whose time_utc sits a few seconds after the disarm, because that
rotation is what closed it. The check that settles it: LOG_DISARMED is 1 or 2, so a log
MUST have been created at boot; if no entry carries a boot-time stamp, the field is not
creation time.
"""

from __future__ import annotations

import argparse
import glob
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
import time

DEVICE = os.environ.get("COORD_FC_DEVICE", "/dev/ttyAMA0")
BAUD = int(os.environ.get("COORD_FC_BAUD", "1500000"))
# The image to borrow pymavlink from. NOT a literal: it is already declared once, as
# service coordinator-mavlink in the stack's compose.yaml, and that file says plainly that
# a value lives there and nowhere else. A copy here would be a second config surface that
# drifts silently the first time the tag moves or a digest is pinned -- and the failure
# would be "ran against the wrong image", which looks like nothing.
IMAGE_ENV = os.environ.get("COORD_FC_IMAGE")
MAVLINK_CONTAINER = "coordinator_mavlink"
MAVLINK_SERVICE = "coordinator-mavlink"

# Bytes per LOG_REQUEST_DATA window. Bounded on purpose -- see pull().
WINDOW = int(os.environ.get("COORD_FC_WINDOW", str(256 * 1024)))

# Our MAVLink identity. Not 1 (the FC) and not 255 (a GCS): a distinct component so a
# concurrent GCS session is distinguishable in the FC's MAV log records.
SRC_SYSTEM = 250
SRC_COMPONENT = 1


def resolve_image() -> str:
    """Ask the box which image the mavlink service uses, rather than repeating it.

    The container is created by `coord start` with a fixed container_name, so inspecting
    it works whether it is running or stopped -- and after a quiesce it is stopped, which
    is exactly when this script runs. Falling back to the compose file covers a box that
    has pulled but never started.
    """
    if IMAGE_ENV:
        return IMAGE_ENV
    rc, out = _run("docker", "inspect", "--format", "{{.Config.Image}}", MAVLINK_CONTAINER)
    if rc == 0 and out:
        return out
    compose_file = os.environ.get("COORD_COMPOSE_FILE")
    if not compose_file:
        found = sorted(glob.glob("/opt/stacks/*/compose.yaml"))
        compose_file = found[0] if len(found) == 1 else None
    if compose_file:
        rc, out = _run("docker", "compose", "-f", compose_file, "config", "--images")
        if rc == 0:
            for line in out.splitlines():
                if MAVLINK_SERVICE in line:
                    return line.strip()
    sys.exit(
        "coord-fc-log: cannot determine the mavlink image. Expected container "
        f"{MAVLINK_CONTAINER} or a stack declaring {MAVLINK_SERVICE}; run `coord pull` "
        "first, or set COORD_FC_IMAGE.")


def _run(*cmd: str) -> "tuple[int, str]":
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        return p.returncode, p.stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return 1, ""


def reexec_in_container() -> "None":
    """Re-run this script inside the mavlink image, which has pymavlink.

    --entrypoint python3 is required: the image's entrypoint runs the router, and without
    the override our arguments are parsed as router flags and the run dies on
    'unrecognized arguments'.
    """
    if shutil.which("docker") is None:
        sys.exit("coord-fc-log: no pymavlink and no docker; cannot reach the FC")
    me = os.path.abspath(__file__)
    # --pull never: the image is a stack service, so a converged vehicle has it by
    # definition and a missing one means something is wrong rather than merely absent.
    # Without this, `docker run` reaches for the network -- on a vehicle that may have no
    # wifi at all, and in the middle of post-flight recovery. Same reasoning, and the same
    # flag, as `coord start --pull never`.
    cmd = [
        "docker", "run", "--rm", "--pull", "never", "--entrypoint", "python3",
        "--device", f"{DEVICE}:{DEVICE}",
        "-v", f"{me}:{me}:ro",
        # Our own hostname in there is a docker id. Same mount, and the same reason, as
        # the stack gives vio-tracker and campod-camera.
        "-v", "/etc/hostname:/etc/host-hostname:ro",
    ]
    cmd += [resolve_image(), me] + sys.argv[1:]
    os.execvp("docker", cmd)


try:
    from pymavlink import mavutil  # noqa: E402
except ImportError:
    mavutil = None
    # Only when we are the script. Importing this module -- which the test does, to
    # exercise the listing without a vehicle -- must not execvp docker out from under
    # the importer.
    if __name__ == "__main__":
        reexec_in_container()


def ev(obj: dict) -> None:
    """One JSONL event on stderr. stdout belongs to the log bytes."""
    sys.stderr.write(json.dumps(obj) + "\n")
    sys.stderr.flush()


def iso_or_none(tutc: int) -> "str | None":
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(tutc)) if tutc else None


def host_name() -> str:
    """The HOST's name. Read from the mount when we are the re-exec'd container copy,
    whose own hostname is a docker id."""
    try:
        n = open("/etc/host-hostname").read().strip()
        if n:
            return n
    except OSError:
        pass
    return socket.gethostname()


def connect():
    os.environ["MAVLINK20"] = "1"
    m = mavutil.mavlink_connection(
        DEVICE, baud=BAUD, source_system=SRC_SYSTEM,
        source_component=SRC_COMPONENT, dialect="ardupilotmega")
    if m.wait_heartbeat(timeout=20) is None:
        sys.exit(f"coord-fc-log: no heartbeat from the FC on {DEVICE}")
    return m


def end_any_transfer(m) -> None:
    """Cancel a transfer the FC is holding. RECOVERY ONLY -- not part of the happy path.

    Cancelling mid-operation leans on ArduPilot's abort handling, which sees far less use
    than its completion path, so this is called only when a listing has demonstrably
    stalled and the FC is holding a transfer that will never finish.
    """
    m.mav.log_request_end_send(m.target_system, m.target_component)
    deadline = time.time() + 3
    while time.time() < deadline:
        if m.recv_match(type=["LOG_DATA", "LOG_ENTRY"], blocking=True, timeout=0.5) is None:
            return


def list_logs(m) -> "dict[int, tuple[int, int]]":
    """Return {id: (size, time_utc)}, having DRAINED THE LISTING TO COMPLETION.

    Draining is not tidiness, it is the whole thing. AP_Logger registers the requesting
    link for the duration of a transfer, and

        handle_log_request_data():
            if (_log_sending_link != nullptr) { ...; return; }

    RETURNS UNCONDITIONALLY -- the channel check inside only decides whether you get a
    "Log download in progress" STATUSTEXT, which is suppressed for a same-channel
    requester. So while a listing is still in progress, every LOG_REQUEST_DATA is
    dropped in silence.

    The listing releases the link only on its last entry
    (`handle_log_send_listing`: `if (_log_next_list_entry == _log_last_list_entry) {
    transfer_activity = IDLE; _log_sending_link = nullptr; }`), and LOG_ENTRY carries
    `last_log_num`, so completion is observable rather than guessed. An earlier version
    stopped reading as soon as it had the entries IT wanted, left the FC listing, and
    then had all twelve of its data requests discarded -- 0 bytes, no error, which read
    as "nothing answered on ttyAMA0" when in fact the FC was still talking.

    This also explains the note this once carried about a single-id request "returning
    nothing": a previous aborted transfer had left the link registered, so the LIST
    request hit the same guard in handle_log_request_list. Nothing to do with single-id.
    """
    ts, tc = m.target_system, m.target_component
    for attempt in (1, 2):
        m.mav.log_request_list_send(ts, tc, 0, 0xffff)
        logs: dict[int, tuple[int, int]] = {}
        while True:
            e = m.recv_match(type="LOG_ENTRY", blocking=True, timeout=5)
            if e is None:
                break
            if e.num_logs == 0:
                return {}          # id and last_log_num are both 0; nothing to list
            logs[e.id] = (e.size, e.time_utc)
            if e.id == e.last_log_num:
                return logs        # the FC is now IDLE; a data request will be accepted
        # Stalled mid-listing: the FC is holding a transfer that will not finish, which
        # is the one situation cancelling repairs. Then try the listing once more.
        print(f"coord-fc-log: log listing stalled after {len(logs)} entries"
              f"{'; cancelling and retrying' if attempt == 1 else ''}",
              file=sys.stderr, flush=True)
        end_any_transfer(m)
    return {}


def cmd_list(_args) -> int:
    """What the FC holds, as JSON. One render path, like coord-sessions and coord-version.

    `time_utc` is the FC's own field and is LAST-MODIFIED, not creation. With
    LOG_FILE_DSRMROT=1 the flight's log is the one stamped a few seconds after the
    disarm, because that rotation is what closed it. A caller presenting this as a
    creation time will pick the wrong log.
    """
    m = connect()
    logs = list_logs(m)
    if not logs:
        print("coord-fc-log: the FC reported no logs", file=sys.stderr)
        return 1
    print(json.dumps({
        "node": host_name(),
        "logs": [
            {"id": i, "bytes": logs[i][0], "time_utc": iso_or_none(logs[i][1])}
            for i in sorted(logs)
        ],
    }, indent=2))
    return 0


# One LOG_DATA carries exactly this many bytes, and every offset ArduPilot sends or
# accepts is a multiple of it (MAVLINK_MSG_LOG_DATA_FIELD_DATA_LEN). Tracking receipt by
# BLOCK rather than by byte is MAVProxy's approach and is why its bookkeeping stays small
# on a multi-gigabyte log: one set entry per 90 bytes, not a flag per byte.
BLOCK = 90

# MAVProxy's cap on how many gap-refill ranges it issues at once
# (mavproxy_log.py: `while num_requests < 20`).
MAX_REFILLS = 20


def state_root() -> str:
    """/var/lib/<stack> for the sole installed stack. Where the partial file goes.

    NOT /tmp: that is tmpfs on a coordinator (1.9 G of 3.7 G RAM), so a 2.4 GB log
    written there is 2.4 GB of RAM.
    """
    try:
        stacks = sorted(os.listdir("/opt/stacks"))
    except OSError:
        stacks = []
    return f"/var/lib/{stacks[0]}" if len(stacks) == 1 else "/var/lib"


def gaps(have: "set[int]", nblocks: int) -> "list[tuple[int, int]]":
    """Missing blocks as (first, count) runs. MAVProxy coalesces the same way."""
    runs = []
    blk = 0
    while blk < nblocks:
        if blk in have:
            blk += 1
            continue
        first = blk
        while blk < nblocks and blk not in have:
            blk += 1
        runs.append((first, blk - first))
    return runs


def pull(m, log_id: int) -> int:
    """Fetch one log, then stream it to stdout.

    THE SHAPE IS MAVPROXY'S, deliberately, after mine failed twice on the vehicle.
    `mavproxy_log.py` asks for the WHOLE log in one request -- ofs 0, count 0xFFFFFFFF --
    lets the FC stream it, and repairs what did not arrive afterwards. It does not window.

    My windowed version asked for 256 KB at a time and waited for each window to fill
    before advancing, and window 0 never filled: 0 bytes, twice, through the API. Two
    things were wrong with it beyond that. 262144 is not a multiple of 90, so every
    window after the first began mid-block, which ArduPilot's offsets never do. And
    waiting per-window serialises what the FC is willing to stream continuously.

    A partial file on the card, not memory. Blocks can arrive out of order and gaps are
    refilled after the first pass, so this needs random access; a seek on a file costs
    nothing and a 2.4 GB buffer costs more RAM than the box has. The file is an internal
    detail -- it is streamed to stdout at the end and removed -- so a caller still sees
    only stdout plus the JSONL on stderr, and nothing is left on the device.
    """
    logs = list_logs(m)
    if log_id not in logs:
        print(f"coord-fc-log: no log with id {log_id}; try `coord fc-log list`",
              file=sys.stderr)
        return 1
    size = logs[log_id][0]
    if size == 0:
        print(f"coord-fc-log: log {log_id} is empty", file=sys.stderr)
        return 1
    nblocks = (size + BLOCK - 1) // BLOCK
    ev({"event": "start", "id": log_id, "bytes": size, "blocks": nblocks})

    # What the FC actually sent. A transfer that does not finish is only diagnosable if
    # we can say whether the FC was silent, busy, or talking -- see the recv loop.
    seen: dict = {}
    said: list = []

    ts, tc = m.target_system, m.target_component
    part = os.path.join(state_root(), f"fc-log-{log_id}.partial")
    t0 = time.time()
    last_report = t0
    have: set = set()

    try:
        with open(part, "w+b") as f:
            f.truncate(size)
            m.mav.log_request_data_send(ts, tc, log_id, 0, 0xFFFFFFFF)
            last_data = time.time()
            stalls = 0

            while len(have) < nblocks:
                # DO NOT FILTER TO LOG_DATA. An earlier version asked recv_match for
                # LOG_DATA alone, so pymavlink discarded everything else -- including
                # the FC's own account of why it was refusing. ArduPilot answers a data
                # request made while another CHANNEL holds the transfer with
                # STATUSTEXT("Log download in progress") and nothing else
                # (AP_Logger_MAVLinkLogTransfer.cpp, handle_log_request_data), so that
                # explanation was deleted unread on every attempt of both failed runs,
                # and the failure got reported as "nothing answered on ttyAMA0".
                d = m.recv_match(blocking=True, timeout=1)
                now = time.time()
                if d is not None:
                    kind = d.get_type()
                    seen[kind] = seen.get(kind, 0) + 1
                    if kind == "STATUSTEXT":
                        txt = getattr(d, "text", "")
                        if isinstance(txt, bytes):
                            txt = txt.decode(errors="replace")
                        txt = str(txt).replace("\x00", "").strip()
                        if txt and txt not in said:
                            said.append(txt)
                    elif kind == "LOG_DATA" and d.id == log_id and d.count:
                        blk = d.ofs // BLOCK
                        if d.ofs % BLOCK == 0 and blk < nblocks and blk not in have:
                            n = min(d.count, size - d.ofs)
                            f.seek(d.ofs)
                            f.write(bytes(d.data[:n]))
                            have.add(blk)
                            last_data = now

                if now - last_report >= 15:
                    el = now - t0
                    got = len(have) * BLOCK
                    rate = got / el if el else 0
                    ev({"event": "progress", "sent": min(got, size), "bytes": size,
                        "rate_kib_s": round(rate / 1024.0, 1),
                        "eta_s": round((size - got) / rate) if rate else None})
                    last_report = now

                if now - last_data > 3:
                    missing = gaps(have, nblocks)
                    if not missing:
                        break
                    stalls += 1
                    if stalls > 12:
                        f.flush()
                        ev({"event": "error", "id": log_id, "bytes": size,
                            "blocks_received": len(have), "blocks_expected": nblocks,
                            "message": (f"stalled with {len(have)} of {nblocks} blocks; "
                                        f"{len(missing)} gap(s) unfilled"),
                            "received": seen, "fc_said": said})
                        return 2
                    # Coalesced refills, block-aligned, MAVProxy's cap.
                    for first, count in missing[:MAX_REFILLS]:
                        m.mav.log_request_data_send(ts, tc, log_id,
                                                    first * BLOCK, count * BLOCK)
                    last_data = time.time()

            # Hand it over, hashing as it goes so the digest is of what the caller gets.
            f.flush()
            os.fsync(f.fileno())
            f.seek(0)
            digest = hashlib.sha256()
            out = sys.stdout.buffer
            sent = 0
            while True:
                chunk = f.read(1024 * 1024)
                if not chunk:
                    break
                out.write(chunk)
                digest.update(chunk)
                sent += len(chunk)
            out.flush()
    finally:
        # Never leave it behind: the card is not a place to keep a copy of something
        # whose home is the archive.
        try:
            os.unlink(part)
        except OSError:
            pass

    el = time.time() - t0
    ev({"event": "done", "node": host_name(), "id": log_id, "bytes": sent,
        "sha256": digest.hexdigest(), "seconds": round(el, 1),
        "received": seen, "fc_said": said})
    return 0


def cmd_pull(args) -> int:
    return pull(connect(), args.id)


def main() -> int:
    p = argparse.ArgumentParser(
        prog="coord fc-log", description="List and pull FC dataflash logs over ttyAMA0.")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="the logs the FC holds, as JSON").set_defaults(fn=cmd_list)
    q = sub.add_parser("pull", help="stream one log to stdout")
    q.add_argument("id", type=int)
    q.set_defaults(fn=cmd_pull)
    args = p.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
