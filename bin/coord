#!/usr/bin/env bash
# Rekon stack operator CLI -- one script for both coordinator and campod devices.
#
# The stack is podman quadlet units under stacks/<name>/, started and stopped through
# their systemd target. Design intent: docs/deployment-model.md.
set -euo pipefail

# A device carries exactly one stack, so nothing takes a stack argument. COORD_STACK
# overrides for a box with more than one installed.
COORD_STACKS_ROOT="${COORD_STACKS_ROOT:-/opt/stacks}"

resolve_stack() {
	if [[ -n ${COORD_STACK:-} ]]; then
		echo "${COORD_STACK}"
		return
	fi
	local found=()
	local d
	for d in "${COORD_STACKS_ROOT}"/*/; do
		[[ -d ${d} ]] && found+=("$(basename "${d}")")
	done
	if [[ ${#found[@]} -eq 1 ]]; then
		echo "${found[0]}"
	elif [[ ${#found[@]} -eq 0 ]]; then
		echo "coord: no stack installed under ${COORD_STACKS_ROOT}" >&2
		exit 1
	else
		echo "coord: multiple stacks under ${COORD_STACKS_ROOT}; set COORD_STACK" >&2
		exit 1
	fi
}

COORD_STACK="$(resolve_stack)"
STACK_DIR="${COORD_STACKS_ROOT}/${COORD_STACK}"
TARGET="${COORD_STACK}-stack.target"

require_stack_dir() {
	if [[ ! -d ${STACK_DIR} ]]; then
		echo "coord: no stack at ${STACK_DIR}" >&2
		exit 1
	fi
}

# The units this stack defines, as systemd unit names.
stack_services() {
	local f
	for f in "${STACK_DIR}"/*.container; do
		[[ -f ${f} ]] || continue
		echo "$(basename "${f}" .container).service"
	done
}

usage() {
	cat <<'EOF'
Usage: coord <command>

  pull              Fetch this stack's images. Does not start or stop anything
  start             Start the stack
  stop              Stop the stack. Returns when it is down
  restart           Stop then start
  status            systemctl status for the stack's units
  logs              Follow the journal for the stack's units
  version           What this machine is running, as TOML
  radio [open|closed]       Report or set the WiFi radio
  fc-log list|pull          FC dataflash logs over ttyAMA0 (stack must be stopped)
  sessions list|package|delete   Capture sessions on this device

Environment:
  COORD_STACK          Stack name under /opt/stacks
  COORD_STACKS_ROOT    Default: /opt/stacks
EOF
}

cmd="${1:-}"
shift || true

case "${cmd}" in
pull)
	# Image names come from the units, which are the only place they appear.
	require_stack_dir
	grep -h '^Image=' "${STACK_DIR}"/*.container | cut -d= -f2- | sort -u |
		xargs -r -n1 podman pull --quiet
	;;
start)
	# The units carry Pull=never, so this starts what is on the box and never fetches.
	require_stack_dir
	systemctl start "${TARGET}"
	;;
stop)
	# Synchronous: returns when the units are inactive, or when their TimeoutStopSec
	# expires and systemd has killed them. Not a sticky off -- the target stays
	# enabled, so a power cycle brings the stack back.
	require_stack_dir
	systemctl stop "${TARGET}"
	;;
restart)
	require_stack_dir
	systemctl restart "${TARGET}"
	;;
status)
	require_stack_dir
	# shellcheck disable=SC2046  # intentional word splitting of the unit list
	systemctl status --no-pager $(stack_services) || true
	;;
logs)
	require_stack_dir
	# shellcheck disable=SC2046
	journalctl -f $(stack_services | sed 's/^/-u /')
	;;
version)
	# No stack check: the probe has to answer on a machine with no stack installed,
	# which the caller needs to tell apart from a machine that did not answer (#326).
	exec /usr/local/bin/coord-version "$@"
	;;
radio)
	# No stack check: `radio open` is the way back to a device whose gadget link
	# stopped working, so gating it on a stack would make recovery need the thing
	# that failed.
	exec /usr/local/bin/coord-radio "$@"
	;;
sessions)
	# Captures outlive any stack (#302).
	exec /usr/local/bin/coord-sessions "$@"
	;;
fc-log)
	# coordinator-mavlink holds /dev/ttyAMA0 while it runs, so that unit has to be
	# stopped first (#77).
	exec /usr/local/bin/coord-fc-log "$@"
	;;
-h | --help | help | "")
	usage
	;;
*)
	echo "coord: unknown command: ${cmd}" >&2
	usage >&2
	exit 1
	;;
esac
