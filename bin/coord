#!/usr/bin/env bash
# Rekon stack operator CLI -- one script for both coordinator and campod devices.
set -euo pipefail

# Stack-aware resolution. A device carries exactly one stack, so the common case needs
# no argument: a campod has only the campod stack installed, the coordinator only the
# coordinator stack.
#
#   1. COORD_STACK (explicit)
#   2. the sole directory under /opt/stacks/*
COORD_STACKS_ROOT="${COORD_STACKS_ROOT:-/opt/stacks}"

resolve_stack() {
	if [[ -n ${COORD_STACK:-} ]]; then
		echo "${COORD_STACK}"
		return
	fi
	local found=()
	local d
	for d in "${COORD_STACKS_ROOT}"/*/; do
		[[ -d ${d} ]] && found+=("$(basename "${d}")")
	done
	if [[ ${#found[@]} -eq 1 ]]; then
		echo "${found[0]}"
	elif [[ ${#found[@]} -eq 0 ]]; then
		echo "coord: no stack installed under ${COORD_STACKS_ROOT}" >&2
		exit 1
	else
		echo "coord: multiple stacks under ${COORD_STACKS_ROOT}; set COORD_STACK" >&2
		printf '  %s\n' "${found[@]}" >&2
		exit 1
	fi
}

COORD_STACK="$(resolve_stack)"
STACK_DIR="${COORD_STACKS_ROOT}/${COORD_STACK}"
TARGET="${COORD_STACK}-stack.target"

# THE CONTAINERS ARE SYSTEMD UNITS (#449). Each stacks/<name>/*.container is a podman
# quadlet file; the generator turns it into <name>.service at boot and on every
# daemon-reload, and each one is PartOf and WantedBy the stack target. So starting and
# stopping the stack is systemctl on that target, and PID 1 -- already resident --
# does the work.
#
# What this replaced: `docker compose` for every verb. Two costs, both measured.
# dockerd held 26.9 MiB of unreclaimable anonymous memory doing nothing between
# container starts, and degraded ~100x under load (`docker ps` 2.1-22.0 s against
# containerd's 126-213 ms on the same box at the same moment), so the tool was at its
# worst exactly when it was needed. And invoking the CLI faulted in 42.6 MiB of mapped
# text plus 28.8 MiB of compose plugin on a 417 MiB board with no swap.
#
# `systemctl` and `journalctl` are already resident as part of PID 1's working set.
# `podman` is only invoked for the verbs that genuinely need a container runtime --
# pull, exec, shell -- none of which are on the boot or flight path.

# Every unit this stack defines, in the order the directory lists them.
stack_units() {
	local f
	for f in "${STACK_DIR}"/*.container; do
		[[ -f ${f} ]] || continue
		basename "${f}" .container
	done
}

require_stack_dir() {
	if [[ ! -d ${STACK_DIR} ]]; then
		echo "coord: no stack at ${STACK_DIR}" >&2
		echo "coord: set COORD_STACK, or converge the device to install one" >&2
		exit 1
	fi
}

usage() {
	cat <<'EOF'
Usage: coord <command> [args]

Commands:
  pull [image...]   Fetch this stack's images (default: all of them). Does not restart
  start [unit...]   Start the stack, or named units (no args: the whole stack)
  stop [unit...]    Stop the stack, or named units. Synchronous -- returns when down
  restart [unit...] Stop then start
  status            systemctl status for the stack
  version           print what this machine is running, one TOML table per unit
  radio             report the WiFi radio and gadget-link state, as TOML
  radio closed      disable WiFi (refuses unless the gadget link is proven)
  radio open        enable WiFi
  fc-log list       FC dataflash logs, over ttyAMA0 (stack must be stopped)
  fc-log pull <id> <out>  fetch one FC log to a file
  sessions list     capture sessions on this device, as JSON
  sessions package  one closed session into a verified bundle
  sessions delete   remove sessions and their bundles (capture must be stopped)
  logs [unit]       Follow the journal for the stack (default: every unit)
  shell [unit]      Interactive shell in a running container (default: the first unit)
  exec <unit> <cmd...>  Run a command in a running container
  units             list the units this stack defines

Environment:
  COORD_STACK          Stack name under /opt/stacks (e.g. coordinator, campod)
  COORD_STACKS_ROOT    Default: /opt/stacks
EOF
}

# The container name a unit runs, read from the unit rather than guessed. `podman exec`
# addresses containers, not units, and the two names differ by convention here
# (campod-camera.container runs campod_camera).
container_of() {
	local unit="${1%.service}"
	unit="${unit%.container}"
	local f="${STACK_DIR}/${unit}.container"
	if [[ ! -f ${f} ]]; then
		echo "coord: no unit ${unit} in ${STACK_DIR}" >&2
		exit 1
	fi
	local name
	name="$(sed -n 's/^ContainerName=//p' "${f}" | head -n1)"
	echo "${name:-${unit}}"
}

cmd="${1:-}"
shift || true

# Resolve unit arguments to systemd unit names. A bare name, a .service name and a
# .container name all work, because all three are things a reader of the stack
# directory might reasonably type.
unit_args() {
	local a
	for a in "$@"; do
		echo "${a%.container}" | sed 's/\.service$//' | sed 's/$/.service/'
	done
}

case "${cmd}" in
pull)
	# Fetch only. Not stop-pull-start: tearing the stack down is a separate decision
	# and a converge calls this while the stack is running.
	#
	# Image names come from the units, which are the only place they appear, so there
	# is no second list to disagree. Fully qualified, as podman-host requires.
	require_stack_dir
	if [[ $# -gt 0 ]]; then
		for image in "$@"; do podman pull --quiet "${image}"; done
	else
		grep -h '^Image=' "${STACK_DIR}"/*.container | cut -d= -f2- | sort -u |
			xargs -r -n1 podman pull --quiet
	fi
	;;
start)
	# The target pulls in every unit WantedBy it, so no argument starts the stack.
	# Named units start just those, which is the bench subset the old compose
	# profiles tried to be:
	#   coord start vio-tracker                  # tracker alone
	#   coord start vio-tracker vio-estimator    # vision chain
	#
	# Nothing here fetches. The units carry Pull=never, so a power-up needs no network
	# (deployment-model.md) and a missing image fails in seconds with a clear error
	# rather than stalling on an unattended fetch. Convergence ends with a pull, so a
	# converged node has its images by definition.
	require_stack_dir
	if [[ $# -gt 0 ]]; then
		# shellcheck disable=SC2046  # intentional word splitting of the unit list
		systemctl start $(unit_args "$@")
	else
		systemctl start "${TARGET}"
	fi
	;;
stop)
	# SYNCHRONOUS, and that is the point. `pkill` returned when the signal was sent,
	# not when the process was gone -- 1.1s for the accel and 19.0s for the camera,
	# both after the command returned -- so every caller needed its own wait loop and
	# two shipped without one. systemctl returns when the units are inactive, or when
	# their TimeoutStopSec expires and systemd has killed them.
	#
	# Stopping the target stops every unit PartOf it. No escalation logic here: the
	# per-unit ceilings live in the quadlet files, next to the measurement that
	# justifies each one.
	#
	# Not a sticky off. The target stays enabled, so a power cycle brings the stack
	# back -- and there is a power cycle between bench and flight by construction. To
	# keep it down across a reboot, disable the target.
	require_stack_dir
	if [[ $# -gt 0 ]]; then
		# shellcheck disable=SC2046
		systemctl stop $(unit_args "$@")
	else
		systemctl stop "${TARGET}"
	fi
	;;
restart)
	require_stack_dir
	if [[ $# -gt 0 ]]; then
		# shellcheck disable=SC2046
		systemctl restart $(unit_args "$@")
	else
		systemctl restart "${TARGET}"
	fi
	;;
status)
	require_stack_dir
	# --no-pager because this is read over ssh as often as at a console.
	# shellcheck disable=SC2046
	systemctl status --no-pager $(unit_args $(stack_units)) || true
	;;
units)
	require_stack_dir
	stack_units
	;;
version)
	# Deliberately no stack check: the probe has to answer on a machine with no stack
	# installed, which is one of the things the caller needs to be able to tell apart
	# from a machine that did not answer (#326).
	exec /usr/local/bin/coord-version "$@"
	;;
radio)
	# No stack check either, and for a sharper reason than the others: the machine you
	# most need this on is one whose stack is broken or absent, and `radio open` is the
	# way back to a device whose gadget link stopped working. Gating it on a stack
	# would make the recovery verb need the thing that failed.
	exec /usr/local/bin/coord-radio "$@"
	;;
sessions)
	# Same reasoning: captures outlive any stack, and a machine whose stack was removed
	# still has data worth listing and packaging (#302).
	exec /usr/local/bin/coord-sessions "$@"
	;;
fc-log)
	# Same reasoning again, plus one of its own: the FC's logs are not ours and do not
	# depend on our stack at all -- but the port does. coordinator-mavlink holds
	# /dev/ttyAMA0 while it is running, so that unit has to be stopped first. #77.
	exec /usr/local/bin/coord-fc-log "$@"
	;;
logs)
	# The journal, not a container log driver. Quadlet units log through systemd, so
	# this is journalctl -- and it means a boot's container output is in the journal
	# that `coord sessions package` already bundles per boot, which docs/
	# post-flight-collection.md previously listed as one of two things not collected.
	require_stack_dir
	if [[ $# -gt 0 ]]; then
		# shellcheck disable=SC2046
		journalctl -f $(unit_args "$@" | sed 's/^/-u /')
	else
		# shellcheck disable=SC2046
		journalctl -f $(unit_args $(stack_units) | sed 's/^/-u /')
	fi
	;;
shell)
	require_stack_dir
	target="${1:-$(stack_units | head -n1)}"
	if [[ -z ${target} ]]; then
		echo "coord: no unit given and none found in ${STACK_DIR}" >&2
		exit 1
	fi
	podman exec -it "$(container_of "${target}")" bash
	;;
exec)
	require_stack_dir
	if [[ $# -lt 2 ]]; then
		echo "coord: exec requires <unit> <command...>" >&2
		exit 1
	fi
	unit="$1"
	shift
	podman exec -it "$(container_of "${unit}")" "$@"
	;;
-h | --help | help | "")
	usage
	;;
*)
	echo "coord: unknown command: ${cmd}" >&2
	usage >&2
	exit 1
	;;
esac
