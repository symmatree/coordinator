#!/usr/bin/env bash
# Rekon stack operator CLI -- one script for both coordinator and campod devices.
set -euo pipefail

# Stack-aware compose-file resolution:
#   1. COORD_COMPOSE_FILE (explicit)
#   2. COORD_STACK -> /opt/stacks/$COORD_STACK/compose.yaml
#   3. the sole stack under /opt/stacks/* (the common case: a campod has only the
#      campod stack installed, the coordinator only the coordinator stack)
COORD_STACKS_ROOT="${COORD_STACKS_ROOT:-/opt/stacks}"

resolve_compose_file() {
	if [[ -n ${COORD_COMPOSE_FILE:-} ]]; then
		echo "${COORD_COMPOSE_FILE}"
		return
	fi
	if [[ -n ${COORD_STACK:-} ]]; then
		echo "${COORD_STACKS_ROOT}/${COORD_STACK}/compose.yaml"
		return
	fi
	local found=()
	local f
	for f in "${COORD_STACKS_ROOT}"/*/compose.yaml; do
		[[ -f ${f} ]] && found+=("${f}")
	done
	if [[ ${#found[@]} -eq 1 ]]; then
		echo "${found[0]}"
	elif [[ ${#found[@]} -eq 0 ]]; then
		echo "${COORD_STACKS_ROOT}/coordinator/compose.yaml"
	else
		echo "coord: multiple stacks under ${COORD_STACKS_ROOT}; set COORD_STACK or COORD_COMPOSE_FILE" >&2
		printf '  %s\n' "${found[@]}" >&2
		exit 1
	fi
}

COORD_COMPOSE_FILE="$(resolve_compose_file)"

compose() {
	docker compose -f "${COORD_COMPOSE_FILE}" "$@"
}

# Default shell target: explicit override, else the stack's first service.
default_service() {
	if [[ -n ${COORD_DEFAULT_SERVICE:-} ]]; then
		echo "${COORD_DEFAULT_SERVICE}"
	else
		compose config --services 2>/dev/null | head -n1
	fi
}

# Overridable so the selection can be tested against a fake tree; nothing but the
# test sets it.
COORD_PROC="${COORD_PROC:-/proc}"

# The program inside each container. Every image we run on a device has
# ENTRYPOINT ["/usr/bin/dumb-init", "--", ...], and every entrypoint script
# `exec`s its program, so at runtime dumb-init's child IS the binary -- there is
# no shell in between. That holds for all six: capture.py, campod-accel,
# router.py, display.py, vins_fusion, feature_tracker.
#
# So this needs no table of binary names to keep in sync with six Dockerfiles,
# and discovers nothing we already know: dumb-init is the one name, and we put it
# there ourselves.
container_binary_pids() {
	local comm pid
	for comm in "${COORD_PROC}"/[0-9]*/comm; do
		[[ -r ${comm} ]] || continue
		[[ $(<"${comm}") == dumb-init ]] || continue
		pid=${comm#"${COORD_PROC}"/}
		pid=${pid%/comm}
		cat "${COORD_PROC}/${pid}/task/${pid}/children" 2>/dev/null
	done
}

stop_processes() {
	local pids
	# shellcheck disable=SC2207  # word splitting is the point
	pids=($(container_binary_pids))
	if ((${#pids[@]} == 0)); then
		echo "coord: no container processes found" >&2
		return 0
	fi
	local pid
	for pid in "${pids[@]}"; do
		echo "coord: SIGTERM ${pid} ($(tr -d '\0' <"${COORD_PROC}/${pid}/cmdline" 2>/dev/null))" >&2
		kill -TERM "${pid}" 2>/dev/null || true
	done
}

usage() {
	cat <<'EOF'
Usage: coord <command> [args]

Commands:
  pull [args]       Stop stack, pull images (args go to `compose pull`), start stack
  start [service...] Start what is on the box; never pulls (no args: the full set)
  stop              docker compose stop (containers remain; a boot unit re-ups them)
  teardown          docker compose down (remove containers + networks)
  restart           docker compose restart [service]
  status            docker compose ps
  version           print what this machine is running, one TOML table per unit
  sessions list     capture sessions on this device, as JSON
  sessions package  one closed session into a verified bundle
  sessions delete   remove sessions and their bundles (capture must be stopped)
  logs [service]    Follow logs (default: all services)
  shell [service]   Interactive shell in service (default: stack's first service)
  exec <service> <cmd...>  Run command in service container

Environment:
  COORD_COMPOSE_FILE   Explicit compose file (overrides stack detection)
  COORD_STACK          Stack name under /opt/stacks (e.g. coordinator, campod)
  COORD_STACKS_ROOT    Default: /opt/stacks
  COORD_DEFAULT_SERVICE Default service for shell (else first service)
EOF
}

require_compose_file() {
	if [[ ! -f ${COORD_COMPOSE_FILE} ]]; then
		echo "coord: compose file not found: ${COORD_COMPOSE_FILE}" >&2
		echo "coord: set COORD_COMPOSE_FILE or install stacks/coordinator to /opt/stacks/coordinator" >&2
		exit 1
	fi
}

cmd="${1:-}"
shift || true

case "${cmd}" in
pull)
	# Extra args go to `compose pull` (e.g. `coord pull -q` from an unattended driver: with no
	# TTY compose re-emits the whole progress display several times a second).
	require_compose_file
	compose down
	compose pull "$@"
	compose up -d
	;;
start)
	# Optional service names select a subset: `coord start vio-tracker` for a
	# tracker-only bench. With no arguments the stack's full operational set comes
	# up. (Compose profiles are additive and cannot subtract, so a subset ladder
	# has to be service names, not profiles -- see stacks/coordinator/compose.yaml.)
	#
	# --pull never: start runs WHAT IS ON THE BOX and never fetches. Without it,
	# `compose up` pulls anything missing, which made the boot unit (#256) capable
	# of spending minutes on an unattended fetch -- on a vehicle that may have no
	# network at all, at the moment it is being powered up to fly.
	#
	# This is what deployment-model.md already required: "A normal power-up must
	# need no network and no `coord pull`." Upgrades are explicit, and `coord pull`
	# is where they happen.
	#
	# "But then a node with no images fails at boot" -- that state is not reachable
	# once convergence ends with a pull, which is the other half of this change
	# (#263). A converged node has its images by definition. If the two land apart
	# there is a window where a node converged by the old path and then rebooted
	# fails instead of self-healing; it fails in seconds with a missing-image error
	# rather than stalling for minutes, which is the better of the two, but the
	# window is the reason these belong together.
	require_compose_file
	compose up -d --pull never "$@"
	;;
stop)
	# SIGTERM the program inside each container and let the existing machinery do
	# the rest: the binary exits, dumb-init sees its child go, containerd reports
	# the task exit, and dockerd runs handleContainerExit -- which tears the
	# container down the same way regardless of who caused the exit. That is the
	# ordinary path for any program in a container finishing.
	#
	# Not `docker compose stop`, which on a campod does not finish. Of four
	# measured attempts one returned (51s) and three never did, twice taking the
	# machine down. dockerd is the layer that degrades: `docker ps` measured at
	# 16-19s while containerd answered the equivalent in 126-213ms and the kernel
	# in ~50ms. Compose also enumerates the project and resolves its resources
	# before signalling anything (pkg/compose/stop.go), which is several daemon
	# round-trips we do not need -- our stacks pin container_name.
	# See analysis/pi-zero-unresponsiveness-experiments.md.
	#
	# No escalation to SIGKILL here on purpose. Signal, wait, send a different
	# signal is what docker already does, and doing it ourselves would just be
	# the same thrashing one layer up. If a container does not exit, that is a
	# result worth seeing rather than something to force.
	stop_processes
	;;
teardown)
	require_compose_file
	compose down
	;;
restart)
	require_compose_file
	compose restart "$@"
	;;
status)
	require_compose_file
	compose ps
	;;
version)
	# Deliberately no require_compose_file: the probe has to answer on a machine
	# with no stack installed, which is one of the things the caller needs to be
	# able to tell apart from a machine that did not answer (#326).
	exec /usr/local/bin/coord-version "$@"
	;;
sessions)
	# Same reasoning: captures outlive any stack, and a machine whose stack was
	# removed still has data worth listing and packaging (#302).
	exec /usr/local/bin/coord-sessions "$@"
	;;
logs)
	require_compose_file
	if [[ $# -gt 0 ]]; then
		compose logs -f "$@"
	else
		compose logs -f
	fi
	;;
shell)
	require_compose_file
	service="${1:-$(default_service)}"
	if [[ -z ${service} ]]; then
		echo "coord: no service given and none found in ${COORD_COMPOSE_FILE}" >&2
		exit 1
	fi
	compose exec -it "${service}" bash
	;;
exec)
	require_compose_file
	if [[ $# -lt 2 ]]; then
		echo "coord: exec requires <service> <command...>" >&2
		exit 1
	fi
	compose exec -it "$@"
	;;
-h | --help | help | "")
	usage
	;;
*)
	echo "coord: unknown command: ${cmd}" >&2
	usage >&2
	exit 1
	;;
esac
