#!/usr/bin/env bash
# Pack the files a device installs -- and nothing else -- into one tarball, so a device
# can fetch an output instead of cloning the repo (#341).
#
# Not installed on a device; this runs in CI (.github/workflows/host-payload.yaml) and
# by hand. What goes in is host/ansible/vars/payload.yml, shared with roles/host-cli.
#
#   bin/build-payload <output-dir>
#
# Paths inside the tarball match the paths in the repo, so an unpacked payload is a
# drop-in for coord_checkout: roles/host-cli reads bin/<tool> and roles/coord-stack
# reads stacks/<role>/ either way.
set -euo pipefail

out_dir=${1:?usage: bin/build-payload <output-dir>}
repo=$(cd "$(dirname "$0")/.." && pwd)

# Set by the workflow from github.sha / github.ref. Falls back to git for a hand run.
version=${PAYLOAD_COMMIT:-$(git -C "$repo" rev-parse HEAD)}
ref=${PAYLOAD_REF:-$(git -C "$repo" rev-parse --abbrev-ref HEAD)}

mkdir -p "$out_dir"
out_dir=$(cd "$out_dir" && pwd)
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
root=$stage/rekon-host

mkdir -p "$root/bin"
while read -r tool; do
	install -m 0755 "$repo/bin/$tool" "$root/bin/$tool"
done < <(python3 "$repo/bin/payload_manifest.py" host_tools)

while read -r role; do
	mkdir -p "$root/stacks/$role"
	install -m 0644 "$repo/stacks/$role"/* "$root/stacks/$role/"
done < <(python3 "$repo/bin/payload_manifest.py" stack_roles)

# The payload has no .git, so this is the only thing that can answer "what is this box
# running". bin/coord-version does not read it yet -- it still probes for a git
# checkout (#341).
cat >"$root/VERSION" <<VER
commit=$version
ref=$ref
VER

tarball=$out_dir/rekon-host-$version.tar.gz
# Fixed ownership and mtime so the same commit packs to the same bytes.
tar -C "$stage" --numeric-owner --owner=0 --group=0 --sort=name \
	--mtime="@$(git -C "$repo" show -s --format=%ct "$version" 2>/dev/null || echo 0)" \
	-czf "$tarball" rekon-host
echo "$tarball"
